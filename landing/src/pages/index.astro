---
import {
  translations,
  CHROME_STORE_URL,
  EDGE_STORE_URL,
  FIREFOX_STORE_URL,
  GITHUB_RELEASES_URL,
} from '../i18n';
import { getLatestVersion } from '../lib/changelog';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import { Hero } from '../components/Hero';
import { Features } from '../components/Features';
import Platforms from '../components/Platforms.astro';
import { ReviewsMarquee } from '../components/ReviewsMarquee';
import Footer from '../components/Footer.astro';

const t = translations.en;
const latestVersion = getLatestVersion();
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  lang="en"
  zhPath="/zh/"
  withJsonLd={true}
>
  <Navbar t={t.nav} />
  <main>
    <Hero
      client:load
      titleLine1={t.hero.titleLine1}
      titleLine2={t.hero.titleGradient}
      description={t.hero.desc}
      primaryCta={t.hero.ctaPrimary}
      secondaryCta={t.hero.ctaSecondary}
      primaryLink={CHROME_STORE_URL}
      secondaryLink="https://ophel.app/docs"
      alternateInstallLabel="All 6 install targets"
      alternateInstallLink="/download/"
      version={latestVersion}
      locale="en"
      browserCtas={{
        chrome: { label: 'Install on Chrome', href: CHROME_STORE_URL },
        edge: { label: 'Install on Edge', href: EDGE_STORE_URL },
        firefox: { label: 'Install on Firefox', href: FIREFOX_STORE_URL },
        safari: { label: 'Download for Safari', href: GITHUB_RELEASES_URL },
        default: { label: t.hero.ctaPrimary, href: CHROME_STORE_URL },
      }}
    />
    <Features
      client:load
      featuresTitle={t.features.title}
      featuresSubtitle={t.features.desc}
      items={t.features.items}
      locale="en"
    />
    <Platforms t={t.platforms} locale="en" />
    <ReviewsMarquee client:load title={t.reviews.title} subtitle={t.reviews.subtitle} />
  </main>
  <Footer t={t.footer} homeHref="/" />
</BaseLayout>
