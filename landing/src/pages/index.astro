---
import { translations, CHROME_STORE_URL, EDGE_STORE_URL, FIREFOX_STORE_URL } from '../i18n';
import { getLatestVersion } from '../lib/changelog';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import { Hero } from '../components/Hero';
import { Features } from '../components/Features';
import Platforms from '../components/Platforms.astro';
import { ReviewsMarquee } from '../components/ReviewsMarquee';
import { FinalCta } from '../components/FinalCta';
import Footer from '../components/Footer.astro';

const t = translations.en;
const latestVersion = getLatestVersion();

const browserCtas = {
  chrome: { label: 'Install on Chrome', href: CHROME_STORE_URL, external: true },
  edge: { label: 'Install on Edge', href: EDGE_STORE_URL, external: true },
  firefox: { label: 'Install on Firefox', href: FIREFOX_STORE_URL, external: true },
  safari: { label: 'Safari (macOS Beta)', href: '/download/#safari', external: false },
  default: { label: t.hero.ctaPrimary, href: CHROME_STORE_URL, external: true },
};
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  lang="en"
  zhPath="/zh/"
  withJsonLd={true}
>
  <Navbar t={t.nav} />
  <main id="main-content">
    <Hero
      client:load
      titleLine1={t.hero.titleLine1}
      titleLine2={t.hero.titleGradient}
      description={t.hero.desc}
      primaryCta={t.hero.ctaPrimary}
      primaryLink={CHROME_STORE_URL}
      alternateInstallLabel="All channels"
      alternateInstallLink="/download/"
      version={latestVersion}
      locale="en"
      browserCtas={browserCtas}
    />
    <Features
      client:visible
      featuresTitle={t.features.title}
      featuresSubtitle={t.features.desc}
      items={t.features.items}
      locale="en"
    />
    <Platforms t={t.platforms} locale="en" />
    <ReviewsMarquee client:visible title={t.reviews.title} subtitle={t.reviews.subtitle} />
    <FinalCta
      client:visible
      t={t.finalCta}
      primaryLink={CHROME_STORE_URL}
      browserCtas={browserCtas}
      locale="en"
    />
  </main>
  <Footer t={t.footer} homeHref="/" />
</BaseLayout>
