---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { translations } from '../../i18n';

const t = translations.en;

// 构建时读取同仓库的 changelog.mdx（稳定可靠，无跨仓库依赖）
const changelogPath = resolve(process.cwd(), '../changelog.mdx');
let rawContent = '';
try {
  rawContent = readFileSync(changelogPath, 'utf-8');
} catch {
  rawContent = '';
}

// 解析 <Update label="..."> MDX 格式
function parseVersions(raw: string) {
  const versions: { label: string; body: string }[] = [];
  const regex = /<Update label="([^"]+)">([\s\S]*?)<\/Update>/g;
  let match;
  while ((match = regex.exec(raw)) !== null) {
    const label = match[1].trim().replace(/^v/i, ''); // 去掉前缀 v
    const body = match[2].trim();
    if (label.toLowerCase().includes('unreleased')) continue;
    versions.push({ label, body });
  }
  return versions;
}

// 简单 Markdown → HTML 转换（仅处理 changelog 所需的子集）
function mdToHtml(md: string): string {
  return (
    md
      // ### 标题
      .replace(
        /^\s*### (.+)$/gm,
        '<h3 class="text-xs font-semibold uppercase tracking-wider text-[color:var(--ink-muted)] mt-6 mb-3">$1</h3>',
      )
      // `code`
      .replace(
        /`([^`]+)`/g,
        '<code class="px-1 py-0.5 text-xs font-mono bg-[color:var(--surface-tint)] text-[color:var(--accent-strong)] rounded">$1</code>',
      )
      // **bold**
      .replace(
        /\*\*(.+?)\*\*/g,
        '<strong class="font-semibold text-[color:var(--ink)]">$1</strong>',
      )
      // [#NNN](GitHub issue URL) → GitHub issue link
      .replace(
        /\[(#[0-9]+)\]\((https:\/\/github\.com\/urzeye\/ophel\/issues\/[0-9]+)\)/g,
        '<a href="$2" target="_blank" rel="noopener noreferrer" class="text-[color:var(--accent-strong)] hover:text-[color:var(--ink-strong)] hover:underline">$1</a>',
      )
      // Backward compatibility for older unsynced content.
      .replace(
        /\(#(\d+)\)/g,
        '(<a href="https://github.com/urzeye/ophel/issues/$1" target="_blank" rel="noopener noreferrer" class="text-[color:var(--accent-strong)] hover:text-[color:var(--ink-strong)] hover:underline">#$1</a>)',
      )
      // 无序列表
      .replace(
        /^\s*- (.+)$/gm,
        '<li class="flex gap-2 text-[color:var(--text-muted)] leading-relaxed text-sm mb-2"><span class="mt-[0.6em] flex-shrink-0 w-2 h-px bg-[color:var(--line-strong)] inline-block"></span><span>$1</span></li>',
      )
      // 空行分段（被列表包裹时不额外加 p）
      .replace(/\n\n+/g, '\n')
      // 将连续 <li> 包进 <ul>
      .replace(
        /(<li[\s\S]*?<\/li>)(\n<li[\s\S]*?<\/li>)*/g,
        (match) => `<ul class="mb-4 list-none pl-0">${match}</ul>`,
      )
      // 去除 ul 内残余换行
      .replace(/<\/li>\n<li/g, '</li><li')
  );
}

const versions = parseVersions(rawContent).slice(0, 20); // 最多显示 20 个版本
---

<BaseLayout
  title="Changelog — Ophel"
  description="All notable changes to Ophel Atlas browser extension. Release notes, bug fixes, and new features."
  lang="en"
  zhPath="/zh/changelog/"
>
  <Navbar t={t.nav} />
  <main class="relative min-h-screen py-24 bg-background">
    <!-- 背景流光 -->
    <div class="pointer-events-none absolute inset-0 bg-grid-white opacity-[0.03]"></div>
    <div
      class="pointer-events-none absolute top-0 left-1/2 w-[600px] h-[300px] -translate-x-1/2 bg-neon-cyan/5 blur-[100px] rounded-full"
    >
    </div>

    <div class="relative z-10 w-full max-w-6xl mx-auto px-6 max-w-3xl">
      <header class="mb-16">
        <h1
          class="text-4xl sm:text-5xl font-extrabold tracking-tight text-[color:var(--ink-strong)] mb-4"
        >
          Changelog
        </h1>
        <p class="text-lg text-[color:var(--text-muted)] mb-6">
          All notable changes to Ophel Atlas are documented here.
        </p>
        <a
          href="https://github.com/urzeye/ophel/blob/main/CHANGELOG.md"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center text-sm font-semibold text-[color:var(--accent-strong)] hover:text-[color:var(--ink-strong)] transition-colors"
        >
          View on GitHub <span class="ml-1 text-[10px]">↗</span>
        </a>
      </header>

      <div class="flex flex-col border-l border-[color:var(--line)] pl-6 sm:pl-10 space-y-16">
        {
          versions.map((v) => (
            <article class="relative">
              <div class="absolute -left-[30px] sm:-left-[46px] top-1 flex flex-col items-center">
                <div class="w-3 h-3 rounded-full bg-background border border-[color:var(--accent-strong)] mb-1 shadow-[0_0_8px_rgba(15,143,138,0.24)]" />
              </div>
              <div class="mb-4">
                <span class="inline-flex py-1 px-3 text-xs font-mono font-bold uppercase tracking-widest text-[color:var(--accent-strong)] border border-[color:var(--line-strong)] rounded-md bg-[color:var(--surface-tint)]">
                  v{v.label}
                </span>
              </div>
              <div class="changelog-body max-w-none" set:html={mdToHtml(v.body)} />
            </article>
          ))
        }
      </div>
    </div>
  </main>
  <Footer t={t.footer} />
</BaseLayout>
