---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { translations } from '../../i18n';

const t = translations.en;

// 构建时从 ophel 仓库读取 CHANGELOG.md
const changelogPath = resolve(process.cwd(), '../../ophel/CHANGELOG.md');
let rawContent = '';
try {
  rawContent = readFileSync(changelogPath, 'utf-8');
} catch {
  rawContent = '# Changelog\n\nCould not load changelog.';
}

// 解析版本块
function parseVersions(raw: string) {
  const lines = raw.split('\n');
  const versions: { label: string; body: string }[] = [];
  let current: { label: string; lines: string[] } | null = null;

  for (const line of lines) {
    const m = line.match(/^## \[(.+?)\]/);
    if (m) {
      if (current) versions.push({ label: current.label, body: current.lines.join('\n').trim() });
      current = { label: m[1], lines: [] };
      continue;
    }
    if (current) {
      if (line.trim() === '---') continue;
      current.lines.push(line);
    }
  }
  if (current) versions.push({ label: current.label, body: current.lines.join('\n').trim() });
  return versions;
}

// 简单 Markdown → HTML 转换（仅处理 changelog 所需的子集）
function mdToHtml(md: string): string {
  return md
    // ### 标题
    .replace(/^### (.+)$/gm, '<h3 class="text-xs font-semibold uppercase tracking-wider text-zinc-500 mt-6 mb-3">$1</h3>')
    // **bold**
    .replace(/\*\*(.+?)\*\*/g, '<strong class="font-semibold text-zinc-200">$1</strong>')
    // (#NNN) → GitHub issue link
    .replace(/\(#(\d+)\)/g, '(<a href="https://github.com/urzeye/ophel/issues/$1" target="_blank" rel="noopener noreferrer" class="text-neon-cyan hover:text-neon-cyan/80 hover:underline">#$1</a>)')
    // 无序列表
    .replace(/^- (.+)$/gm, '<li class="relative pl-6 text-zinc-400 leading-relaxed text-sm mb-2 before:content-[\'\'] before:absolute before:left-0 before:top-2.5 before:w-2 before:h-px before:bg-zinc-600">$1</li>')
    // 空行分段（被列表包裹时不额外加 p）
    .replace(/\n\n+/g, '\n')
    // 将连续 <li> 包进 <ul>
    .replace(/(<li[\s\S]*?<\/li>)(\n<li[\s\S]*?<\/li>)*/g, (match) => `<ul class="mb-4">${match}</ul>`)
    // 去除 ul 内残余换行
    .replace(/<\/li>\n<li/g, '</li><li');
}

const versions = parseVersions(rawContent).slice(0, 20); // 最多显示 20 个版本
---

<BaseLayout
  title="Changelog — Ophel"
  description="All notable changes to Ophel Atlas browser extension. Release notes, bug fixes, and new features."
  lang="en"
  zhPath="/zh/changelog/"
>
  <Navbar t={t.nav} />
  <main class="relative min-h-screen py-24 bg-background">
    <!-- 背景流光 -->
    <div class="pointer-events-none absolute inset-0 bg-grid-white opacity-[0.03]"></div>
    <div class="pointer-events-none absolute top-0 left-1/2 w-[600px] h-[300px] -translate-x-1/2 bg-neon-cyan/5 blur-[100px] rounded-full"></div>
    
    <div class="relative z-10 w-full max-w-6xl mx-auto px-6 max-w-3xl">
      <header class="mb-16">
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white mb-4">
          Changelog
        </h1>
        <p class="text-lg text-zinc-400 mb-6">
          All notable changes to Ophel Atlas are documented here.
        </p>
        <a
          href="https://github.com/urzeye/ophel/blob/main/CHANGELOG.md"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center text-sm font-semibold text-neon-cyan hover:text-neon-cyan/80 transition-colors"
        >
          View on GitHub <span class="ml-1 text-[10px]">↗</span>
        </a>
      </header>

      <div class="flex flex-col border-l border-white/10 pl-6 sm:pl-10 space-y-16">
        {versions.map((v) => (
          <article class="relative">
            <div class="absolute -left-[30px] sm:-left-[46px] top-1 flex flex-col items-center">
              <div class="w-3 h-3 rounded-full bg-background border border-neon-cyan mb-1 shadow-[0_0_8px_rgba(0,240,255,0.4)]"></div>
            </div>
            <div class="mb-4">
              <span class="inline-flex py-1 px-3 text-xs font-mono font-bold uppercase tracking-widest text-neon-cyan border border-neon-cyan/30 rounded-md bg-neon-cyan/5">
                v{v.label}
              </span>
            </div>
            <div class="changelog-body prose-invert max-w-none" set:html={mdToHtml(v.body)} />
          </article>
        ))}
      </div>
    </div>
  </main>
  <Footer t={t.footer} />
</BaseLayout>
