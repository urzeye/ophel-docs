---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import { translations, CHROME_STORE_URL, EDGE_STORE_URL } from '../../../i18n';
import { SpotlightCard } from '../../../components/ui/SpotlightCard';
import { getSupportedPlatforms } from '../../../lib/supported-platforms';

const t = translations.zh;

const platforms = [
  {
    name: 'Chrome',
    icon: '🌐',
    badge: '推荐',
    desc: '从 Chrome 网上应用店安装，适用于 Chrome、Edge、Brave、Arc 及所有基于 Chromium 的浏览器。',
    cta: '安装到 Chrome',
    href: CHROME_STORE_URL,
    note: '需要 Chrome 88+',
  },
  {
    name: 'Edge',
    icon: '🔷',
    badge: null,
    desc: '从 Microsoft Edge 外接程序商店直接安装，专为 Edge 浏览器适配。',
    cta: '安装到 Edge',
    href: EDGE_STORE_URL,
    note: '需要 Edge 88+',
  },
  {
    name: 'Firefox',
    icon: '🦊',
    badge: null,
    desc: '从 Firefox 附加组件商店安装，功能与 Chrome 扩展完全一致。',
    cta: '安装到 Firefox',
    href: 'https://addons.mozilla.org/firefox/addon/ophel-ai-chat-enhancer/',
    note: '需要 Firefox 109+',
  },
  {
    name: '油猴脚本',
    icon: '🐵',
    badge: null,
    desc: '通过 Greasy Fork 安装油猴脚本，适用于任何支持 Tampermonkey 或 Violentmonkey 的浏览器。',
    cta: '从 Greasy Fork 安装',
    href: 'https://greasyfork.org/scripts/563646-ophel-ai-chat-page-enhancer',
    note: '需要 Tampermonkey 或 Violentmonkey',
  },
  {
    name: 'ScriptCat',
    icon: '🐱',
    badge: null,
    desc: '从 ScriptCat 脚本页安装油猴脚本，适合使用 ScriptCat 脚本管理器的用户。',
    cta: '从 ScriptCat 安装',
    href: 'https://scriptcat.org/script-show-page/6519',
    note: '需要 ScriptCat',
  },
  {
    name: 'GitHub Releases',
    icon: '📦',
    badge: null,
    desc: '从 GitHub Releases 下载最新版 .zip 或 .xpi 安装包，用于手动安装或自托管部署。',
    cta: '前往 Releases',
    href: 'https://github.com/urzeye/ophel/releases',
    note: '提供 ZIP 与 XPI 安装包',
  },
];

const allSupportedSites = getSupportedPlatforms('zh');
const supportedSitesRow1 = allSupportedSites.slice(0, 6);
const supportedSitesRow2 = allSupportedSites.slice(6);

const iconImgs: Record<string, string> = {
  Chrome: '/icons/chrome.svg',
  Edge: '/icons/edge.svg',
  Firefox: '/icons/firefox.svg',
  油猴脚本: '/icons/tampermonkey.svg',
  ScriptCat: '/icons/scriptcat.png',
  'GitHub Releases': '/icons/github.svg',
};
---

<BaseLayout
  title="下载安装 Ophel — Chrome、Firefox、油猴脚本、ScriptCat"
  description="免费安装 Ophel 到 Chrome、Firefox、Edge、Tampermonkey 或 ScriptCat。支持 ChatGPT、Gemini、Claude 等 15 个 AI 平台。"
  lang="zh-CN"
  enPath="/download/"
>
  <Navbar t={t.nav} homeHref="/zh/" />
  <main class="relative min-h-screen py-24 bg-background">
    <!-- 背景流光 -->
    <div class="pointer-events-none absolute inset-0 bg-grid-white opacity-[0.03]"></div>
    <div
      class="pointer-events-none absolute top-[10%] left-1/2 w-[800px] h-[500px] -translate-x-1/2 bg-neon-cyan/10 blur-[120px] rounded-full"
    >
    </div>

    <div class="relative z-10 w-full max-w-6xl mx-auto px-6 max-w-4xl">
      <header class="text-center mb-16">
        <p
          class="inline-flex items-center rounded-full border border-[color:var(--line-strong)] bg-[color:var(--surface-tint)] px-3 py-1 text-xs font-bold uppercase tracking-widest text-[color:var(--accent-strong)] mb-6"
        >
          免费 · 无需注册
        </p>
        <h1
          class="text-4xl sm:text-6xl font-extrabold tracking-tight text-[color:var(--ink-strong)] mb-6"
        >
          安装 Ophel
        </h1>
        <p class="text-lg text-[color:var(--text-muted)] max-w-2xl mx-auto leading-relaxed">
          一个扩展，支持 <strong class="text-[color:var(--ink-strong)]"
            >{allSupportedSites.length} 个 AI 平台</strong
          >，覆盖主流浏览器。
        </p>
      </header>

      <div class="grid gap-6 md:grid-cols-2 mb-16">
        {
          platforms.map((p) => (
            <SpotlightCard className="p-6 group border-[color:var(--line)] bg-white/70 shadow-[0_18px_48px_rgba(31,43,64,0.1)] hover:border-[color:var(--line-strong)]">
              <div class="relative z-10 flex gap-4 h-full">
                <div class="flex-shrink-0 pt-1 group-hover:scale-110 transition-transform">
                  {iconImgs[p.name] ? (
                    <img src={iconImgs[p.name]} alt={p.name} width="36" height="36" />
                  ) : (
                    <span class="text-3xl">{p.icon}</span>
                  )}
                </div>
                <div class="flex flex-col flex-1">
                  <div class="flex items-center gap-3 mb-2">
                    <h2 class="text-lg font-bold text-[color:var(--ink)] group-hover:text-[color:var(--ink-strong)] transition-colors">
                      {p.name}
                    </h2>
                    {p.badge && (
                      <span class="px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white bg-[color:var(--accent-strong)] rounded-full">
                        {p.badge}
                      </span>
                    )}
                  </div>
                  <p class="text-sm text-[color:var(--text-muted)] leading-relaxed mb-4 flex-1">
                    {p.desc}
                  </p>
                  <div class="mt-auto">
                    <a
                      href={p.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center text-sm font-semibold text-[color:var(--accent-strong)] hover:text-[color:var(--ink-strong)] transition-colors"
                    >
                      {p.cta} <span class="ml-1 text-[10px]">↗</span>
                    </a>
                    <span class="block mt-1.5 text-xs text-[color:var(--text-faint)]">
                      {p.note}
                    </span>
                  </div>
                </div>
              </div>
            </SpotlightCard>
          ))
        }
      </div>

      <section class="mb-16">
        <div
          class="rounded-2xl border border-[color:var(--line)] bg-white/70 p-6 shadow-[0_18px_48px_rgba(31,43,64,0.08)]"
        >
          <p
            class="mb-2 text-xs font-bold uppercase tracking-widest text-[color:var(--accent-strong)]"
          >
            商店版本状态
          </p>
          <h2 class="mb-3 text-xl font-bold text-[color:var(--ink-strong)]">
            商店版本可能晚于 GitHub Releases
          </h2>
          <p class="text-sm leading-relaxed text-[color:var(--text-muted)]">
            GitHub Releases、浏览器商店提交、商店审核和分发是不同步骤。Chrome 网上应用店、Microsoft
            Edge add-ons、Firefox 附加组件商店、Greasy Fork 和 ScriptCat
            可能在不同时间发布新版本。如需确认当前已发布版本，请以各公开页面显示的版本为准。
          </p>
        </div>
      </section>

      <section class="mb-16">
        <h2 class="text-xl font-bold text-[color:var(--ink-strong)] mb-6 flex items-center gap-2">
          <span class="h-px bg-[color:var(--line)] flex-1"></span>
          支持的平台
          <span class="h-px bg-[color:var(--line)] flex-1"></span>
        </h2>
        <div class="dl-sites-container flex flex-col items-center gap-3">
          <div class="dl-sites-row flex flex-nowrap justify-center gap-3">
            {
              supportedSitesRow1.map((site) => (
                <a
                  href={site.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  title={site.href}
                  aria-label={`打开 ${site.label}`}
                  class="inline-flex items-center gap-2.5 px-4 py-2 text-sm font-semibold text-[color:var(--ink-muted)] bg-white/70 border border-[color:var(--line)] rounded-full hover:border-[color:var(--line-strong)] hover:text-[color:var(--ink-strong)] hover:bg-white transition-colors"
                >
                  {site.iconSrc ? (
                    <span
                      class={`inline-flex items-center justify-center shrink-0 ${site.iconVariant === 'inverted' ? 'w-5 h-5 rounded-full bg-[color:var(--ink)] border border-[color:var(--line)]' : ''}`}
                    >
                      <img
                        src={site.iconSrc}
                        alt=""
                        width="18"
                        height="18"
                        class={`shrink-0 ${site.iconVariant === 'inverted' ? 'w-4 h-4 [filter:brightness(0)_invert(1)]' : ''}`}
                        loading="lazy"
                      />
                    </span>
                  ) : (
                    <span class="shrink-0">{site.emoji}</span>
                  )}
                  <span>{site.label}</span>
                </a>
              ))
            }
          </div>
          <div class="dl-sites-row flex flex-nowrap justify-center gap-3">
            {
              supportedSitesRow2.map((site) => (
                <a
                  href={site.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  title={site.href}
                  aria-label={`打开 ${site.label}`}
                  class="inline-flex items-center gap-2.5 px-4 py-2 text-sm font-semibold text-[color:var(--ink-muted)] bg-white/70 border border-[color:var(--line)] rounded-full hover:border-[color:var(--line-strong)] hover:text-[color:var(--ink-strong)] hover:bg-white transition-colors"
                >
                  {site.iconSrc ? (
                    <span
                      class={`inline-flex items-center justify-center shrink-0 ${site.iconVariant === 'inverted' ? 'w-5 h-5 rounded-full bg-[color:var(--ink)] border border-[color:var(--line)]' : ''}`}
                    >
                      <img
                        src={site.iconSrc}
                        alt=""
                        width="18"
                        height="18"
                        class={`shrink-0 ${site.iconVariant === 'inverted' ? 'w-4 h-4 [filter:brightness(0)_invert(1)]' : ''}`}
                        loading="lazy"
                      />
                    </span>
                  ) : (
                    <span class="shrink-0">{site.emoji}</span>
                  )}
                  <span>{site.label}</span>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section>
        <div
          class="p-8 md:p-10 rounded-2xl bg-white/70 border border-[color:var(--line)] shadow-[0_18px_48px_rgba(31,43,64,0.08)]"
        >
          <h2 class="text-2xl font-bold text-[color:var(--ink-strong)] mb-8">快速开始</h2>
          <ol class="space-y-8">
            <li class="flex gap-5">
              <span
                class="flex-shrink-0 flex items-center justify-center w-8 h-8 rounded-full border border-[color:var(--line-strong)] bg-[color:var(--surface-tint)] text-sm font-bold text-[color:var(--accent-strong)]"
                >1</span
              >
              <div>
                <strong class="block text-base font-semibold text-[color:var(--ink)] mb-1.5">
                  安装扩展
                </strong>
                <p class="text-sm text-[color:var(--text-muted)] leading-relaxed">
                  选择上方任一安装方式并添加到浏览器。
                </p>
              </div>
            </li>
            <li class="flex gap-5">
              <span
                class="flex-shrink-0 flex items-center justify-center w-8 h-8 rounded-full border border-[color:var(--line-strong)] bg-[color:var(--surface-tint)] text-sm font-bold text-[color:var(--accent-strong)]"
                >2</span
              >
              <div>
                <strong class="block text-base font-semibold text-[color:var(--ink)] mb-1.5"
                  >打开支持的 AI 网站</strong
                >
                <p class="text-sm text-[color:var(--text-muted)] leading-relaxed">
                  访问 ChatGPT、Gemini、Claude 或其他 15 个支持平台中的任意一个。
                </p>
              </div>
            </li>
            <li class="flex gap-5">
              <span
                class="flex-shrink-0 flex items-center justify-center w-8 h-8 rounded-full border border-[color:var(--line-strong)] bg-[color:var(--surface-tint)] text-sm font-bold text-[color:var(--accent-strong)]"
                >3</span
              >
              <div>
                <strong class="block text-base font-semibold text-[color:var(--ink)] mb-1.5"
                  >Ophel 自动激活</strong
                >
                <p class="text-sm text-[color:var(--text-muted)] leading-relaxed">
                  面板会出现在页面右侧，点击切换按钮即可展开。
                </p>
              </div>
            </li>
          </ol>
        </div>
      </section>
    </div>
  </main>
  <Footer t={t.footer} />
</BaseLayout>

<style>
  @media (max-width: 768px) {
    .dl-sites-container {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
    }
    .dl-sites-row {
      display: contents;
    }
  }
</style>
