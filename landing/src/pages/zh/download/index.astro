---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import {
  translations,
  CHROME_STORE_URL,
  EDGE_STORE_URL,
  FIREFOX_STORE_URL,
  GITHUB_RELEASES_URL,
  GREASYFORK_URL,
  SCRIPTCAT_URL,
} from '../../../i18n';
import { SpotlightCard } from '../../../components/ui/SpotlightCard';
import {
  getSupportedPlatforms,
  getSitePacks,
  BUILTIN_PLATFORM_COUNT,
  SITE_PACK_COUNT,
} from '../../../lib/supported-platforms';

const t = translations.zh;

const platforms = [
  {
    name: 'Chrome',
    icon: '/icons/chrome.svg',
    badge: '推荐',
    desc: '从 Chrome 网上应用店安装，适用于 Chrome、Brave、Arc、Vivaldi 及所有 Chromium 内核浏览器。',
    cta: '安装到 Chrome',
    href: CHROME_STORE_URL,
    note: '需要 Chrome 88+ · 支持商店自动更新',
  },
  {
    name: 'Microsoft Edge',
    icon: '/icons/edge.svg',
    badge: null,
    desc: '从 Microsoft Edge 外接程序商店直接安装，无需跨区即可在 Edge 中高速下载。',
    cta: '安装到 Edge',
    href: EDGE_STORE_URL,
    note: '需要 Edge 88+ · 官方商店直装',
  },
  {
    name: 'Firefox',
    icon: '/icons/firefox.svg',
    badge: null,
    desc: '从 Mozilla Firefox 附加组件商店安装，具备与 Chrome 版完全一致的功能与本地隐私保护。',
    cta: '安装到 Firefox',
    href: FIREFOX_STORE_URL,
    note: '需要 Firefox 109+ · 官方 AMO 签名',
  },
  {
    name: 'Safari',
    icon: '/icons/safari.svg',
    badge: 'macOS',
    desc: '从 GitHub Releases 下载 macOS 桌面端 Safari 扩展构建包，通过 Safari 开发者功能加载使用。',
    cta: '前往 GitHub Releases 下载',
    href: GITHUB_RELEASES_URL,
    note: '支持 macOS Safari · 见 Releases 安装说明',
  },
  {
    name: 'Tampermonkey 油猴脚本',
    icon: '/icons/tampermonkey.svg',
    badge: null,
    desc: '通过 Greasy Fork 安装油猴脚本版本，适用于任何安装了 Tampermonkey 或 Violentmonkey 的浏览器。',
    cta: '从 Greasy Fork 安装',
    href: GREASYFORK_URL,
    note: '需要 Tampermonkey 或 Violentmonkey',
  },
  {
    name: 'ScriptCat 脚本猫',
    icon: '/icons/scriptcat.png',
    badge: null,
    desc: '从 ScriptCat 脚本站一键安装，适合偏好使用脚本猫管理器的国内用户。',
    cta: '从 ScriptCat 安装',
    href: SCRIPTCAT_URL,
    note: '需要 ScriptCat 脚本猫管理器',
  },
  {
    name: 'GitHub Releases (ZIP / XPI / Safari / User.js)',
    icon: '/icons/github.svg',
    badge: '离线与手动安装',
    desc: '直接从 GitHub Releases 下载最新发布的 Chrome (.zip)、Firefox (.xpi)、Safari 资源包及油猴脚本。',
    cta: '打开 GitHub Releases',
    href: GITHUB_RELEASES_URL,
    note: '第一时间获取最新构建包',
  },
];

const allSupportedSites = getSupportedPlatforms('zh');
const allSitePacks = getSitePacks('zh');
---

<BaseLayout
  title="下载安装 Ophel — Chrome、Edge、Firefox、Safari、油猴脚本"
  description="免费安装 Ophel 到 Chrome、Edge、Firefox、Safari、Tampermonkey 或 ScriptCat。支持 16 个内置 AI 平台与 16 个热插拔站点适配包。"
  lang="zh-CN"
  enPath="/download/"
>
  <Navbar t={t.nav} homeHref="/zh/" />
  <main class="relative min-h-screen py-18 sm:py-24 bg-background">
    <div class="relative z-10 w-full max-w-[1040px] mx-auto px-5 sm:px-6">
      <header class="text-center mb-14">
        <h1
          class="font-display text-4xl sm:text-6xl font-extrabold tracking-tight text-[color:var(--ink-strong)] mb-5"
        >
          安装 Ophel Atlas
        </h1>
        <p
          class="text-base sm:text-lg text-[color:var(--text-muted)] max-w-2xl mx-auto leading-relaxed"
        >
          开源免费（GPLv3），无需注册账号。开箱支持{' '}
          <strong class="text-[color:var(--ink-strong)]">
            {BUILTIN_PLATFORM_COUNT} 个内置 AI 平台
          </strong>{' '}
          与{' '}
          <strong class="text-[color:var(--ink-strong)]">
            {SITE_PACK_COUNT} 个热插拔站点适配包
          </strong>
          。
        </p>
      </header>

      <div class="grid gap-5 md:grid-cols-2 mb-16">
        {
          platforms.map((p, idx) => (
            <SpotlightCard
              spotlightColor="rgba(13, 122, 117, 0.1)"
              className={`p-6 group border-[color:var(--line)] bg-white/80 shadow-[0_14px_36px_rgba(24,33,49,0.08)] hover:border-[color:var(--line-strong)] ${
                idx === platforms.length - 1 ? 'md:col-span-2' : ''
              }`}
            >
              <div class="relative z-10 flex gap-4 h-full">
                <div class="flex-shrink-0 pt-1 group-hover:scale-105 transition-transform">
                  <img src={p.icon} alt="" width="36" height="36" />
                </div>
                <div class="flex flex-col flex-1">
                  <div class="flex flex-wrap items-center gap-2.5 mb-2">
                    <h2 class="font-display text-lg font-extrabold text-[color:var(--ink)] group-hover:text-[color:var(--ink-strong)] transition-colors">
                      {p.name}
                    </h2>
                    {p.badge && (
                      <span class="px-2.5 py-0.5 font-mono text-[11px] font-bold text-white bg-[color:var(--accent-strong)] rounded-full">
                        {p.badge}
                      </span>
                    )}
                  </div>
                  <p class="text-sm text-[color:var(--text-muted)] leading-relaxed mb-4 flex-1">
                    {p.desc}
                  </p>
                  <div class="mt-auto">
                    <a
                      href={p.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center text-sm font-bold text-[color:var(--accent-strong)] hover:text-[color:var(--ink-strong)] transition-colors"
                    >
                      {p.cta} <span class="ml-1 text-xs">↗</span>
                    </a>
                    <span class="block mt-1.5 font-mono text-xs text-[color:var(--text-faint)]">
                      {p.note}
                    </span>
                  </div>
                </div>
              </div>
            </SpotlightCard>
          ))
        }
      </div>

      <section class="mb-14">
        <div
          class="rounded-2xl border border-[color:var(--line)] bg-white/80 p-6 shadow-[0_14px_36px_rgba(24,33,49,0.06)]"
        >
          <h2 class="mb-2.5 font-display text-xl font-extrabold text-[color:var(--ink-strong)]">
            商店审核进度与 GitHub Releases 说明
          </h2>
          <p class="text-sm leading-relaxed text-[color:var(--text-muted)]">
            每次版本发布时，GitHub Releases 会第一时间提供全平台构建包（含 Chrome、Firefox、Safari
            及油猴脚本）。Chrome 网上应用店、Microsoft Edge 商店与 Firefox
            附加组件商店由于需要经过各自的审核队列，上线时间可能比 GitHub 晚 1–3 天。
          </p>
        </div>
      </section>

      <section class="mb-14">
        <h2 class="font-display text-xl font-extrabold text-[color:var(--ink-strong)] mb-4">
          {BUILTIN_PLATFORM_COUNT} 个内置 AI 平台（开箱即用）
        </h2>
        <div class="flex flex-wrap gap-2.5">
          {
            allSupportedSites.map((site) => (
              <a
                href={site.href}
                target="_blank"
                rel="noopener noreferrer"
                title={site.domain}
                class="inline-flex items-center gap-2 px-3.5 py-2 text-sm font-bold text-[color:var(--ink-muted)] bg-white/80 border border-[color:var(--line)] rounded-full hover:border-[color:var(--line-strong)] hover:text-[color:var(--ink-strong)] hover:bg-white transition-colors"
              >
                <span
                  class={`inline-flex items-center justify-center shrink-0 ${
                    site.iconVariant === 'inverted'
                      ? 'w-5 h-5 rounded-full bg-[color:var(--ink-strong)]'
                      : ''
                  }`}
                >
                  <img
                    src={site.iconSrc}
                    alt=""
                    width="18"
                    height="18"
                    class={`shrink-0 ${
                      site.iconVariant === 'inverted'
                        ? 'w-3.5 h-3.5 [filter:brightness(0)_invert(1)]'
                        : ''
                    }`}
                    loading="lazy"
                  />
                </span>
                <span>{site.label}</span>
              </a>
            ))
          }
        </div>

        <h2 class="font-display text-xl font-extrabold text-[color:var(--ink-strong)] mt-10 mb-4">
          {SITE_PACK_COUNT} 个热插拔站点适配包（适配中心一键启用）
        </h2>
        <div class="flex flex-wrap gap-2">
          {
            allSitePacks.map((pack) => (
              <a
                href={pack.href}
                target="_blank"
                rel="noopener noreferrer"
                title={pack.domain}
                class="inline-flex items-center gap-2 px-3.5 py-1.5 text-xs font-bold text-[color:var(--ink-muted)] bg-white/65 border border-[color:var(--line)] rounded-full hover:border-[color:var(--line-strong)] hover:text-[color:var(--ink-strong)] hover:bg-white transition-colors"
              >
                <span>{pack.label}</span>
                <span class="font-mono text-[10px] text-[color:var(--text-faint)]">
                  {pack.domain}
                </span>
              </a>
            ))
          }
        </div>
      </section>

      <section>
        <div
          class="p-8 md:p-10 rounded-2xl bg-white/80 border border-[color:var(--line)] shadow-[0_14px_36px_rgba(24,33,49,0.06)]"
        >
          <h2 class="font-display text-2xl font-extrabold text-[color:var(--ink-strong)] mb-8">
            三步快速上手
          </h2>
          <ol class="space-y-6">
            <li class="flex gap-4">
              <span
                class="flex-shrink-0 flex items-center justify-center w-7 h-7 rounded-full border border-[color:var(--line-strong)] bg-[color:var(--surface-tint)] font-mono text-xs font-bold text-[color:var(--accent-strong)]"
              >
                1
              </span>
              <div>
                <strong class="block text-base font-bold text-[color:var(--ink-strong)] mb-1">
                  安装对应浏览器的 Ophel 扩展
                </strong>
                <p class="text-sm text-[color:var(--text-muted)] leading-relaxed">
                  选择上方任一渠道（Chrome、Edge、Firefox、Safari
                  或油猴脚本）完成安装，无需注册账号。
                </p>
              </div>
            </li>
            <li class="flex gap-4">
              <span
                class="flex-shrink-0 flex items-center justify-center w-7 h-7 rounded-full border border-[color:var(--line-strong)] bg-[color:var(--surface-tint)] font-mono text-xs font-bold text-[color:var(--accent-strong)]"
              >
                2
              </span>
              <div>
                <strong class="block text-base font-bold text-[color:var(--ink-strong)] mb-1">
                  打开任意受支持的 AI 网站（或在适配中心启用适配包）
                </strong>
                <p class="text-sm text-[color:var(--text-muted)] leading-relaxed">
                  访问 ChatGPT、Gemini、Claude、Gemini Notebook、DeepSeek 等 16
                  个内置平台，或在「设置 → 适配中心」开启更多站点。
                </p>
              </div>
            </li>
            <li class="flex gap-4">
              <span
                class="flex-shrink-0 flex items-center justify-center w-7 h-7 rounded-full border border-[color:var(--line-strong)] bg-[color:var(--surface-tint)] font-mono text-xs font-bold text-[color:var(--accent-strong)]"
              >
                3
              </span>
              <div>
                <strong class="block text-base font-bold text-[color:var(--ink-strong)] mb-1">
                  使用实时大纲、文件夹与全局搜索
                </strong>
                <p class="text-sm text-[color:var(--text-muted)] leading-relaxed">
                  Ophel 面板会自动停靠在对话页面右侧；随时按下 Ctrl/⌘ + K 即可唤起全局语法搜索。
                </p>
              </div>
            </li>
          </ol>
        </div>
      </section>
    </div>
  </main>
  <Footer t={t.footer} homeHref="/zh/" />
</BaseLayout>
