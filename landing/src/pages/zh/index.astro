---
import { translations, CHROME_STORE_URL, EDGE_STORE_URL, FIREFOX_STORE_URL } from '../../i18n';
import { getLatestVersion } from '../../lib/changelog';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import { Hero } from '../../components/Hero';
import { Features } from '../../components/Features';
import Platforms from '../../components/Platforms.astro';
import { ReviewsMarquee } from '../../components/ReviewsMarquee';
import { FinalCta } from '../../components/FinalCta';
import Footer from '../../components/Footer.astro';

const t = translations.zh;
const latestVersion = getLatestVersion();

const browserCtas = {
  chrome: { label: '安装 Chrome 扩展', href: CHROME_STORE_URL, external: true },
  edge: { label: '安装 Edge 扩展', href: EDGE_STORE_URL, external: true },
  firefox: { label: '安装到 Firefox', href: FIREFOX_STORE_URL, external: true },
  safari: { label: 'Safari（macOS 实验版）', href: '/zh/download/#safari', external: false },
  default: { label: t.hero.ctaPrimary, href: CHROME_STORE_URL, external: true },
};
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  lang="zh-CN"
  enPath="/"
  withJsonLd={true}
>
  <Navbar t={t.nav} homeHref="/zh/" />
  <main id="main-content">
    <Hero
      client:load
      titleLine1={t.hero.titleLine1}
      titleLine2={t.hero.titleGradient}
      description={t.hero.desc}
      primaryCta={t.hero.ctaPrimary}
      primaryLink={CHROME_STORE_URL}
      alternateInstallLabel="全部渠道"
      alternateInstallLink="/zh/download/"
      version={latestVersion}
      locale="zh"
      browserCtas={browserCtas}
    />
    <Features
      client:visible
      featuresTitle={t.features.title}
      featuresSubtitle={t.features.desc}
      items={t.features.items}
      locale="zh"
    />
    <Platforms t={t.platforms} locale="zh" />
    <ReviewsMarquee
      client:visible
      title={t.reviews.title}
      subtitle={t.reviews.subtitle}
      locale="zh"
    />
    <FinalCta
      client:visible
      t={t.finalCta}
      primaryLink={CHROME_STORE_URL}
      browserCtas={browserCtas}
      locale="zh"
    />
  </main>
  <Footer t={t.footer} homeHref="/zh/" />
</BaseLayout>
