---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { translations, CHROME_STORE_URL } from '../../i18n';
import { SpotlightCard } from '../../components/ui/SpotlightCard';
import { getSupportedPlatforms } from '../../lib/supported-platforms';

const t = translations.en;

const platforms = [
  {
    name: 'Chrome',
    icon: '🌐',
    badge: 'Recommended',
    desc: 'Install from the Chrome Web Store. Works on Chrome, Edge, Brave, Arc, and all Chromium-based browsers.',
    cta: 'Install on Chrome',
    href: CHROME_STORE_URL,
    note: 'Chrome 88+ required',
  },
  {
    name: 'Firefox',
    icon: '🦊',
    badge: null,
    desc: 'Install from Firefox Add-ons. Full feature parity with the Chrome extension.',
    cta: 'Install on Firefox',
    href: 'https://addons.mozilla.org/zh-CN/firefox/addon/ophel-ai-chat-enhancer/',
    note: 'Firefox 109+ required',
  },
  {
    name: 'Tampermonkey',
    icon: '🐵',
    badge: null,
    desc: 'Install as a userscript via Greasy Fork. Works in any browser that supports Tampermonkey or Violentmonkey.',
    cta: 'Install via Greasy Fork',
    href: 'https://greasyfork.org/zh-CN/scripts/563646-ophel-ai-chat-page-enhancer',
    note: 'Requires Tampermonkey or Violentmonkey',
  },
  {
    name: 'GitHub Releases',
    icon: '📦',
    badge: null,
    desc: 'Download the latest .zip or .xpi package from GitHub Releases for manual setup or self-hosting.',
    cta: 'Open Releases',
    href: 'https://github.com/urzeye/ophel/releases',
    note: 'ZIP and XPI packages available',
  },
];

const allSupportedSites = getSupportedPlatforms('en');
const supportedSitesRow1 = allSupportedSites.slice(0, 6);
const supportedSitesRow2 = allSupportedSites.slice(6);

const iconImgs: Record<string, string> = {
  Chrome: '/icons/chrome.svg',
  Firefox: '/icons/firefox.svg',
  Tampermonkey: '/icons/tampermonkey.svg',
  'GitHub Releases': '/icons/github.svg',
  // Edge: '/icons/edge.svg',  // Edge Store 上架审核中，暂时注释
};
---

<BaseLayout
  title="Download & Install Ophel — Chrome, Firefox, Tampermonkey"
  description="Install Ophel free on Chrome, Firefox, Edge, and Tampermonkey. Works with ChatGPT, Gemini, Claude, and 15 AI platforms."
  lang="en"
  zhPath="/zh/download/"
  withJsonLd={false}
>
  <Navbar t={t.nav} />
  <main class="relative min-h-screen py-24 bg-background">
    <!-- 背景流光 -->
    <div class="pointer-events-none absolute inset-0 bg-grid-white opacity-[0.03]"></div>
    <div
      class="pointer-events-none absolute top-[10%] left-1/2 w-[800px] h-[500px] -translate-x-1/2 bg-neon-cyan/10 blur-[120px] rounded-full"
    >
    </div>

    <div class="relative z-10 w-full max-w-6xl mx-auto px-6 max-w-4xl">
      <header class="text-center mb-16">
        <p
          class="inline-flex items-center rounded-full border border-neon-cyan/20 bg-neon-cyan/5 px-3 py-1 text-xs font-medium uppercase tracking-widest text-neon-cyan mb-6"
        >
          Free · No account required
        </p>
        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white mb-6">
          Install Ophel
        </h1>
        <p class="text-lg text-zinc-400 max-w-2xl mx-auto leading-relaxed">
          One extension. Works with <strong class="text-white"
            >{allSupportedSites.length} AI platforms</strong
          >. Available for all major browsers.
        </p>
      </header>

      <div class="grid gap-6 md:grid-cols-2 mb-16">
        {
          platforms.map((p) => (
            <SpotlightCard className="p-6 group">
              <div class="relative z-10 flex gap-4 h-full">
                <div class="flex-shrink-0 pt-1 group-hover:scale-110 transition-transform">
                  {iconImgs[p.name] ? (
                    <img src={iconImgs[p.name]} alt={p.name} width="36" height="36" />
                  ) : (
                    <span class="text-3xl">{p.icon}</span>
                  )}
                </div>
                <div class="flex flex-col flex-1">
                  <div class="flex items-center gap-3 mb-2">
                    <h2 class="text-lg font-bold text-zinc-100 group-hover:text-white transition-colors">
                      {p.name}
                    </h2>
                    {p.badge && (
                      <span class="px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-black bg-neon-cyan rounded-full">
                        {p.badge}
                      </span>
                    )}
                  </div>
                  <p class="text-sm text-zinc-400 leading-relaxed mb-4 flex-1">{p.desc}</p>
                  <div class="mt-auto">
                    <a
                      href={p.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center text-sm font-semibold text-neon-cyan hover:text-neon-cyan/80 transition-colors"
                    >
                      {p.cta} <span class="ml-1 text-[10px]">↗</span>
                    </a>
                    <span class="block mt-1.5 text-xs text-zinc-600">{p.note}</span>
                  </div>
                </div>
              </div>
            </SpotlightCard>
          ))
        }
      </div>

      <section class="mb-16">
        <h2 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
          <span class="h-px bg-white/20 flex-1"></span>
          Supported Platforms
          <span class="h-px bg-white/20 flex-1"></span>
        </h2>
        <div class="dl-sites-container flex flex-col items-center gap-3">
          <div class="dl-sites-row flex flex-nowrap justify-center gap-3">
            {
              supportedSitesRow1.map((site) => (
                <a
                  href={site.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  title={site.href}
                  aria-label={`Open ${site.label}`}
                  class="inline-flex items-center gap-2.5 px-4 py-2 text-sm font-medium text-zinc-300 bg-surface border border-surface-border rounded-full hover:border-neon-cyan/30 hover:text-white hover:bg-white/[0.03] transition-colors whitespace-nowrap"
                >
                  {site.iconSrc ? (
                    <span
                      class={`inline-flex items-center justify-center shrink-0 ${site.iconVariant === 'inverted' ? 'w-5 h-5 rounded-full bg-white/10 border border-white/15' : ''}`}
                    >
                      <img
                        src={site.iconSrc}
                        alt=""
                        width="18"
                        height="18"
                        class={`shrink-0 ${site.iconVariant === 'inverted' ? 'w-4 h-4 [filter:brightness(0)_invert(1)]' : ''}`}
                        loading="lazy"
                      />
                    </span>
                  ) : (
                    <span class="shrink-0">{site.emoji}</span>
                  )}
                  <span>{site.label}</span>
                </a>
              ))
            }
          </div>
          <div class="dl-sites-row flex flex-nowrap justify-center gap-3">
            {
              supportedSitesRow2.map((site) => (
                <a
                  href={site.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  title={site.href}
                  aria-label={`Open ${site.label}`}
                  class="inline-flex items-center gap-2.5 px-4 py-2 text-sm font-medium text-zinc-300 bg-surface border border-surface-border rounded-full hover:border-neon-cyan/30 hover:text-white hover:bg-white/[0.03] transition-colors whitespace-nowrap"
                >
                  {site.iconSrc ? (
                    <span
                      class={`inline-flex items-center justify-center shrink-0 ${site.iconVariant === 'inverted' ? 'w-5 h-5 rounded-full bg-white/10 border border-white/15' : ''}`}
                    >
                      <img
                        src={site.iconSrc}
                        alt=""
                        width="18"
                        height="18"
                        class={`shrink-0 ${site.iconVariant === 'inverted' ? 'w-4 h-4 [filter:brightness(0)_invert(1)]' : ''}`}
                        loading="lazy"
                      />
                    </span>
                  ) : (
                    <span class="shrink-0">{site.emoji}</span>
                  )}
                  <span>{site.label}</span>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section>
        <div class="p-8 md:p-10 rounded-2xl bg-surface border border-surface-border">
          <h2 class="text-2xl font-bold text-white mb-8">Quick Start</h2>
          <ol class="space-y-8">
            <li class="flex gap-5">
              <span
                class="flex-shrink-0 flex items-center justify-center w-8 h-8 rounded-full border border-white/10 bg-white/5 text-sm font-bold text-white shadow-[0_0_15px_rgba(0,240,255,0.2)]"
                >1</span
              >
              <div>
                <strong class="block text-base font-semibold text-white mb-1.5"
                  >Install the extension</strong
                >
                <p class="text-sm text-zinc-400 leading-relaxed">
                  Click "Install on Chrome" above and add it to your browser.
                </p>
              </div>
            </li>
            <li class="flex gap-5">
              <span
                class="flex-shrink-0 flex items-center justify-center w-8 h-8 rounded-full border border-white/10 bg-white/5 text-sm font-bold text-white shadow-[0_0_15px_rgba(0,240,255,0.2)]"
                >2</span
              >
              <div>
                <strong class="block text-base font-semibold text-white mb-1.5"
                  >Open any supported AI site</strong
                >
                <p class="text-sm text-zinc-400 leading-relaxed">
                  Visit ChatGPT, Gemini, Claude, or any of the 15 supported platforms.
                </p>
              </div>
            </li>
            <li class="flex gap-5">
              <span
                class="flex-shrink-0 flex items-center justify-center w-8 h-8 rounded-full border border-white/10 bg-white/5 text-sm font-bold text-white shadow-[0_0_15px_rgba(0,240,255,0.2)]"
                >3</span
              >
              <div>
                <strong class="block text-base font-semibold text-white mb-1.5"
                  >Ophel activates automatically</strong
                >
                <p class="text-sm text-zinc-400 leading-relaxed">
                  The panel appears on the right side. Click the toggle button to open it.
                </p>
              </div>
            </li>
          </ol>
        </div>
      </section>
    </div>
  </main>
  <Footer t={t.footer} />
</BaseLayout>

<style>
  @media (max-width: 768px) {
    .dl-sites-container {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
    }
    .dl-sites-row {
      display: contents;
    }
  }
</style>
