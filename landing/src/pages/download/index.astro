---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import {
  translations,
  CHROME_STORE_URL,
  EDGE_STORE_URL,
  FIREFOX_STORE_URL,
  GITHUB_RELEASES_URL,
  GREASYFORK_URL,
  SCRIPTCAT_URL,
} from '../../i18n';
import { SpotlightCard } from '../../components/ui/SpotlightCard';
import {
  getSupportedPlatforms,
  getSitePacks,
  BUILTIN_PLATFORM_COUNT,
  SITE_PACK_COUNT,
} from '../../lib/supported-platforms';

const t = translations.en;

const platforms = [
  {
    name: 'Chrome',
    icon: '/icons/chrome.svg',
    badge: 'Recommended',
    desc: 'Install from the Chrome Web Store. Works on Chrome, Brave, Arc, Vivaldi, and all Chromium-based browsers.',
    cta: 'Install on Chrome',
    href: CHROME_STORE_URL,
    note: 'Chrome 88+ · Automatic store updates',
  },
  {
    name: 'Microsoft Edge',
    icon: '/icons/edge.svg',
    badge: null,
    desc: 'Install directly from the Microsoft Edge Add-ons store for native Edge integration.',
    cta: 'Install on Edge',
    href: EDGE_STORE_URL,
    note: 'Edge 88+ · Official Edge Add-ons listing',
  },
  {
    name: 'Firefox',
    icon: '/icons/firefox.svg',
    badge: null,
    desc: 'Install from Mozilla Firefox Add-ons with full feature parity and strict local-only privacy.',
    cta: 'Install on Firefox',
    href: FIREFOX_STORE_URL,
    note: 'Firefox 109+ · Official AMO listing',
  },
  {
    name: 'Safari',
    icon: '/icons/safari.svg',
    badge: 'macOS',
    desc: 'Download the Safari Web Extension package from GitHub Releases for desktop Safari on macOS.',
    cta: 'Download from GitHub Releases',
    href: GITHUB_RELEASES_URL,
    note: 'macOS Safari · Load via Develop / Temporary Extension',
  },
  {
    name: 'Tampermonkey',
    icon: '/icons/tampermonkey.svg',
    badge: null,
    desc: 'Install as a userscript via Greasy Fork. Runs in any browser with Tampermonkey or Violentmonkey.',
    cta: 'Install via Greasy Fork',
    href: GREASYFORK_URL,
    note: 'Requires Tampermonkey or Violentmonkey',
  },
  {
    name: 'ScriptCat',
    icon: '/icons/scriptcat.png',
    badge: null,
    desc: 'Install the userscript directly from ScriptCat if you prefer the ScriptCat manager ecosystem.',
    cta: 'Install via ScriptCat',
    href: SCRIPTCAT_URL,
    note: 'Requires ScriptCat manager',
  },
  {
    name: 'GitHub Releases (ZIP / XPI / User.js)',
    icon: '/icons/github.svg',
    badge: 'Offline & Manual',
    desc: 'Download signed release archives (.zip, .xpi, Safari bundle, and .user.js) directly from GitHub Releases.',
    cta: 'Open GitHub Releases',
    href: GITHUB_RELEASES_URL,
    note: 'Direct packages for Chrome, Firefox, Safari & Userscript',
  },
];

const allSupportedSites = getSupportedPlatforms('en');
const allSitePacks = getSitePacks('en');
---

<BaseLayout
  title="Download & Install Ophel — Chrome, Edge, Firefox, Safari, Tampermonkey"
  description="Install Ophel free on Chrome, Edge, Firefox, Safari, Tampermonkey, or ScriptCat. Works with 16 built-in AI platforms and 16 hot-swappable Site Packs."
  lang="en"
  zhPath="/zh/download/"
  withJsonLd={false}
>
  <Navbar t={t.nav} />
  <main class="relative min-h-screen py-18 sm:py-24 bg-background">
    <div class="relative z-10 w-full max-w-[1040px] mx-auto px-5 sm:px-6">
      <header class="text-center mb-14">
        <h1
          class="font-display text-4xl sm:text-6xl font-extrabold tracking-tight text-[color:var(--ink-strong)] mb-5"
        >
          Install Ophel Atlas
        </h1>
        <p
          class="text-base sm:text-lg text-[color:var(--text-muted)] max-w-2xl mx-auto leading-relaxed"
        >
          Free and open-source (GPLv3). Works across{' '}
          <strong class="text-[color:var(--ink-strong)]">
            {BUILTIN_PLATFORM_COUNT} built-in AI platforms
          </strong>{' '}
          and{' '}
          <strong class="text-[color:var(--ink-strong)]">
            {SITE_PACK_COUNT} hot-swappable Site Packs
          </strong>.
        </p>
      </header>

      <div class="grid gap-5 md:grid-cols-2 mb-16">
        {
          platforms.map((p, idx) => (
            <SpotlightCard
              spotlightColor="rgba(13, 122, 117, 0.1)"
              className={`p-6 group border-[color:var(--line)] bg-white/80 shadow-[0_14px_36px_rgba(24,33,49,0.08)] hover:border-[color:var(--line-strong)] ${
                idx === platforms.length - 1 ? 'md:col-span-2' : ''
              }`}
            >
              <div class="relative z-10 flex gap-4 h-full">
                <div class="flex-shrink-0 pt-1 group-hover:scale-105 transition-transform">
                  <img src={p.icon} alt="" width="36" height="36" />
                </div>
                <div class="flex flex-col flex-1">
                  <div class="flex flex-wrap items-center gap-2.5 mb-2">
                    <h2 class="font-display text-lg font-extrabold text-[color:var(--ink)] group-hover:text-[color:var(--ink-strong)] transition-colors">
                      {p.name}
                    </h2>
                    {p.badge && (
                      <span class="px-2.5 py-0.5 font-mono text-[11px] font-bold text-white bg-[color:var(--accent-strong)] rounded-full">
                        {p.badge}
                      </span>
                    )}
                  </div>
                  <p class="text-sm text-[color:var(--text-muted)] leading-relaxed mb-4 flex-1">
                    {p.desc}
                  </p>
                  <div class="mt-auto">
                    <a
                      href={p.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center text-sm font-bold text-[color:var(--accent-strong)] hover:text-[color:var(--ink-strong)] transition-colors"
                    >
                      {p.cta} <span class="ml-1 text-xs">↗</span>
                    </a>
                    <span class="block mt-1.5 font-mono text-xs text-[color:var(--text-faint)]">
                      {p.note}
                    </span>
                  </div>
                </div>
              </div>
            </SpotlightCard>
          ))
        }
      </div>

      <section class="mb-14">
        <div
          class="rounded-2xl border border-[color:var(--line)] bg-white/80 p-6 shadow-[0_14px_36px_rgba(24,33,49,0.06)]"
        >
          <h2 class="mb-2.5 font-display text-xl font-extrabold text-[color:var(--ink-strong)]">
            Store rollout vs. GitHub Releases
          </h2>
          <p class="text-sm leading-relaxed text-[color:var(--text-muted)]">
            GitHub Releases publish immediately upon each tagged release (including Chrome, Firefox,
            Safari, and Userscript builds). Browser web stores (Chrome Web Store, Microsoft Edge
            Add-ons, Firefox Add-ons) undergo separate review queues and may roll out a day or two
            later.
          </p>
        </div>
      </section>

      <section class="mb-14">
        <h2 class="font-display text-xl font-extrabold text-[color:var(--ink-strong)] mb-4">
          {BUILTIN_PLATFORM_COUNT} Built-in AI Platforms
        </h2>
        <div class="flex flex-wrap gap-2.5">
          {
            allSupportedSites.map((site) => (
              <a
                href={site.href}
                target="_blank"
                rel="noopener noreferrer"
                title={site.domain}
                class="inline-flex items-center gap-2 px-3.5 py-2 text-sm font-bold text-[color:var(--ink-muted)] bg-white/80 border border-[color:var(--line)] rounded-full hover:border-[color:var(--line-strong)] hover:text-[color:var(--ink-strong)] hover:bg-white transition-colors"
              >
                <span
                  class={`inline-flex items-center justify-center shrink-0 ${
                    site.iconVariant === 'inverted'
                      ? 'w-5 h-5 rounded-full bg-[color:var(--ink-strong)]'
                      : ''
                  }`}
                >
                  <img
                    src={site.iconSrc}
                    alt=""
                    width="18"
                    height="18"
                    class={`shrink-0 ${
                      site.iconVariant === 'inverted'
                        ? 'w-3.5 h-3.5 [filter:brightness(0)_invert(1)]'
                        : ''
                    }`}
                    loading="lazy"
                  />
                </span>
                <span>{site.label}</span>
              </a>
            ))
          }
        </div>

        <h2 class="font-display text-xl font-extrabold text-[color:var(--ink-strong)] mt-10 mb-4">
          {SITE_PACK_COUNT} Hot-Swappable Site Packs
        </h2>
        <div class="flex flex-wrap gap-2">
          {
            allSitePacks.map((pack) => (
              <a
                href={pack.href}
                target="_blank"
                rel="noopener noreferrer"
                title={pack.domain}
                class="inline-flex items-center gap-2 px-3.5 py-1.5 text-xs font-bold text-[color:var(--ink-muted)] bg-white/65 border border-[color:var(--line)] rounded-full hover:border-[color:var(--line-strong)] hover:text-[color:var(--ink-strong)] hover:bg-white transition-colors"
              >
                <span>{pack.label}</span>
                <span class="font-mono text-[10px] text-[color:var(--text-faint)]">
                  {pack.domain}
                </span>
              </a>
            ))
          }
        </div>
      </section>

      <section>
        <div
          class="p-8 md:p-10 rounded-2xl bg-white/80 border border-[color:var(--line)] shadow-[0_14px_36px_rgba(24,33,49,0.06)]"
        >
          <h2 class="font-display text-2xl font-extrabold text-[color:var(--ink-strong)] mb-8">
            Quick Start in 3 Steps
          </h2>
          <ol class="space-y-6">
            <li class="flex gap-4">
              <span
                class="flex-shrink-0 flex items-center justify-center w-7 h-7 rounded-full border border-[color:var(--line-strong)] bg-[color:var(--surface-tint)] font-mono text-xs font-bold text-[color:var(--accent-strong)]"
              >
                1
              </span>
              <div>
                <strong class="block text-base font-bold text-[color:var(--ink-strong)] mb-1">
                  Install Ophel for your browser
                </strong>
                <p class="text-sm text-[color:var(--text-muted)] leading-relaxed">
                  Pick Chrome, Edge, Firefox, Safari, or Tampermonkey above. No account or API key
                  is required.
                </p>
              </div>
            </li>
            <li class="flex gap-4">
              <span
                class="flex-shrink-0 flex items-center justify-center w-7 h-7 rounded-full border border-[color:var(--line-strong)] bg-[color:var(--surface-tint)] font-mono text-xs font-bold text-[color:var(--accent-strong)]"
              >
                2
              </span>
              <div>
                <strong class="block text-base font-bold text-[color:var(--ink-strong)] mb-1">
                  Open any of the 16 built-in AI sites (or enable Site Packs)
                </strong>
                <p class="text-sm text-[color:var(--text-muted)] leading-relaxed">
                  Visit ChatGPT, Gemini, Claude, Gemini Notebook, DeepSeek, or enable additional
                  Site Packs in Settings → Site Packs.
                </p>
              </div>
            </li>
            <li class="flex gap-4">
              <span
                class="flex-shrink-0 flex items-center justify-center w-7 h-7 rounded-full border border-[color:var(--line-strong)] bg-[color:var(--surface-tint)] font-mono text-xs font-bold text-[color:var(--accent-strong)]"
              >
                3
              </span>
              <div>
                <strong class="block text-base font-bold text-[color:var(--ink-strong)] mb-1">
                  Navigate with real-time outlines, folders, and prompts
                </strong>
                <p class="text-sm text-[color:var(--text-muted)] leading-relaxed">
                  The Ophel panel docks cleanly beside your chat. Press Ctrl/⌘ + K anytime to launch
                  Global Search.
                </p>
              </div>
            </li>
          </ol>
        </div>
      </section>
    </div>
  </main>
  <Footer t={t.footer} homeHref="/" />
</BaseLayout>
