---
import { translations } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const t = translations.en;
const p = t.privacy;
---

<BaseLayout title={p.title} description={p.metaDesc} lang="en" zhPath="/zh/privacy/">
  <Navbar t={t.nav} />
  <main class="prose-page">
    <div class="prose-inner">
      <h1>{p.h1}</h1>
      <p class="updated">
        {p.updatedLabel}
        {new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>

      <h2>{p.sections.collection.title}</h2>
      <p>
        {p.sections.collection.p1}<strong>{p.sections.collection.p1Strong}</strong>
      </p>
      <p>
        {p.sections.collection.p2}<code>chrome.storage.local</code>{p.sections.collection.p2Suffix}
      </p>

      <h2>{p.sections.permissions.title}</h2>
      <ul>
        <li><strong>activeTab / scripting</strong>: {p.sections.permissions.activeTab}</li>
        <li><strong>storage</strong>: {p.sections.permissions.storage}</li>
        <li><strong>notifications</strong> {p.sections.permissions.notifications}</li>
      </ul>
      <p>{p.sections.permissions.noNetwork}</p>

      <h2>{p.sections.webdav.title}</h2>
      <p>{p.sections.webdav.p}</p>

      <h2>{p.sections.thirdParty.title}</h2>
      <p>{p.sections.thirdParty.p}</p>

      <h2>{p.sections.contact.title}</h2>
      <p>
        {p.sections.contact.pre}<a
          href="https://github.com/urzeye/ophel/issues"
          target="_blank"
          rel="noopener noreferrer">{p.sections.contact.linkLabel}</a
        >{p.sections.contact.post}
      </p>
    </div>
  </main>
  <Footer t={t.footer} homeHref="/" />
</BaseLayout>

<style>
  .prose-page {
    padding: 72px 24px 96px;
  }

  .prose-inner {
    max-width: 68ch;
    margin: 0 auto;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--ink-strong);
    letter-spacing: -0.025em;
    margin-bottom: 8px;
  }

  .updated {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-faint);
    margin-bottom: 48px;
  }

  h2 {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--ink-strong);
    margin: 40px 0 12px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }

  p {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.75;
    margin-bottom: 16px;
  }

  ul {
    padding-left: 20px;
    margin-bottom: 16px;
  }

  li {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.75;
    margin-bottom: 8px;
  }

  strong {
    color: var(--ink-strong);
    font-weight: 700;
  }

  code {
    font-size: 0.85em;
    padding: 2px 6px;
    border-radius: 5px;
    background: var(--surface-tint);
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-weight: 600;
  }

  a {
    color: var(--accent-strong);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
