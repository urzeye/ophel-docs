---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { uninstallSurveyI18n, type UninstallSurveyLang } from '../../i18n';

// ── PostHog 配置 ──────────────────────────────────────────────
// 在 PostHog 后台 Project Settings 复制 Project API Key（phc_ 开头，
// 该公钥设计为可在客户端公开），替换下面的占位值即可启用提交。
const POSTHOG_API_KEY = 'phc_q4eou3AFBafHUebahDH3DbGPEwA4fwwe8iEVcVUo7Exy';
// 按项目所在区域选择：https://us.i.posthog.com 或 https://eu.i.posthog.com
const POSTHOG_HOST = 'https://us.i.posthog.com';

const en = uninstallSurveyI18n.en;
const surveyStrings = uninstallSurveyI18n;
const reasonKeys = Object.keys(en.reasons) as (keyof typeof en.reasons)[];

// 语言选择器：标签用各语言原生名
const langOptions: { value: UninstallSurveyLang; label: string }[] = [
  { value: 'zh-CN', label: '简体中文' },
  { value: 'zh-TW', label: '繁體中文' },
  { value: 'en', label: 'English' },
  { value: 'ja', label: '日本語' },
  { value: 'ko', label: '한국어' },
  { value: 'it', label: 'Italiano' },
  { value: 'de', label: 'Deutsch' },
  { value: 'es', label: 'Español' },
  { value: 'fr', label: 'Français' },
  { value: 'pt', label: 'Português' },
  { value: 'ru', label: 'Русский' },
];
---

<BaseLayout
  title={en.metaTitle}
  description={en.metaDesc}
  lang="en"
  enPath="/uninstall/"
  zhPath="/uninstall/"
  robots="noindex, nofollow"
>
  <main class="uninstall-page">
    <a class="brand" href="/" data-home-link>
      <img src="/logo.png" alt="" width="30" height="30" />
      <span>Ophel</span>
    </a>

    <div class="card">
      <section id="survey-view">
        <h1 data-i18n="heading">{en.heading}</h1>
        <p class="sub" data-i18n="sub">{en.sub}</p>

        <form id="survey-form">
          <section class="question">
            <h2 id="reason-title" data-i18n="reasonTitle">{en.reasonTitle}</h2>
            <div class="reasons" id="reasons" role="radiogroup" aria-labelledby="reason-title">
              {
                reasonKeys.map((key) => (
                  <label class="reason">
                    <input type="radio" name="reason" value={key} required />
                    <span>{en.reasons[key]}</span>
                  </label>
                ))
              }
            </div>
          </section>

          <section class="question">
            <h2 id="detail-title" data-i18n="detailTitle">{en.detailTitle}</h2>
            <textarea
              id="detail"
              rows="3"
              maxlength="1000"
              placeholder={en.detailPlaceholder}
              aria-labelledby="detail-title"></textarea>
          </section>

          <button type="submit" class="submit-btn" id="submit-btn">{en.submit}</button>
          <p class="form-error" id="form-error" role="alert" hidden></p>
          <noscript>
            <p class="form-error">
              This survey needs JavaScript to submit. 此问卷需要启用 JavaScript 才能提交。
            </p>
          </noscript>
        </form>
      </section>

      <section id="thanks-view" hidden>
        <div class="success-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor">
            <path
              d="M4.5 12.5l5 5 10-11"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
        <h1 id="thanks-title" tabindex="-1" data-i18n="thanksTitle">{en.thanksTitle}</h1>
        <p class="sub" data-i18n="thanksBody">{en.thanksBody}</p>
        <a class="submit-btn" id="reinstall-link" href="/download/">{en.reinstall}</a>
      </section>

      <div class="card-footer">
        <p data-i18n="footerNote">{en.footerNote}</p>
        <div class="footer-actions">
          <button type="button" class="skip-btn" id="skip-btn">{en.skip}</button>
          <select id="lang-select" aria-label="Language">
            {langOptions.map((option) => <option value={option.value}>{option.label}</option>)}
          </select>
        </div>
      </div>
    </div>
  </main>

  <script define:vars={{ surveyStrings, posthogApiKey: POSTHOG_API_KEY, posthogHost: POSTHOG_HOST }}
  >
    const params = new URLSearchParams(window.location.search);

    // l 参数来自 chrome.i18n.getUILanguage()（BCP-47 标签），映射到 11 种支持语言
    function resolveLang(raw) {
      const tag = String(raw || '').toLowerCase();
      if (tag.startsWith('zh')) {
        return tag.includes('tw') ||
          tag.includes('hk') ||
          tag.includes('mo') ||
          tag.includes('hant')
          ? 'zh-TW'
          : 'zh-CN';
      }
      const prefix = tag.split('-')[0];
      return Object.prototype.hasOwnProperty.call(surveyStrings, prefix) ? prefix : 'en';
    }

    let lang = resolveLang(params.get('l') || navigator.language);

    const el = (id) => document.getElementById(id);
    const strings = () => surveyStrings[lang] || surveyStrings.en;

    function applyLang(next) {
      lang = next;
      const s = strings();
      document.documentElement.lang = lang;
      document.title = s.metaTitle;
      document.querySelectorAll('[data-i18n]').forEach((node) => {
        const value = s[node.getAttribute('data-i18n')];
        if (typeof value === 'string') node.textContent = value;
      });
      document.querySelectorAll('#reasons .reason').forEach((label) => {
        const input = label.querySelector('input');
        const span = label.querySelector('span');
        const value = s.reasons[input.value];
        if (typeof value === 'string') span.textContent = value;
      });
      el('detail').placeholder = s.detailPlaceholder;
      el('submit-btn').textContent = s.submit;
      el('skip-btn').textContent = s.skip;
      el('reinstall-link').textContent = s.reinstall;
      el('reinstall-link').href = lang.startsWith('zh') ? '/zh/download/' : '/download/';
      el('form-error').textContent = s.error;
      el('lang-select').value = lang;
      document.querySelector('[data-home-link]').href = lang.startsWith('zh') ? '/zh/' : '/';

      const nextParams = new URLSearchParams(window.location.search);
      nextParams.set('l', lang);
      window.history.replaceState(null, '', `${window.location.pathname}?${nextParams.toString()}`);
    }

    function showThanks() {
      el('survey-view').hidden = true;
      el('thanks-view').hidden = false;
      el('skip-btn').hidden = true;
      // 焦点移到感谢标题，读屏与键盘用户能感知视图切换
      el('thanks-title').focus({ preventScroll: true });
    }

    el('lang-select').addEventListener('change', (event) => applyLang(event.target.value));
    el('skip-btn').addEventListener('click', showThanks);

    el('survey-form').addEventListener('submit', async (event) => {
      event.preventDefault();
      const reason = new FormData(event.target).get('reason');
      if (!reason) return;

      const s = strings();
      const btn = el('submit-btn');
      const errorEl = el('form-error');
      btn.disabled = true;
      btn.textContent = s.submitting;
      errorEl.hidden = true;

      const properties = {
        $lib: 'web/uninstall-survey',
        v: params.get('v') || undefined,
        browser: params.get('b') || undefined,
        ui_language: lang,
        reason,
        comment: el('detail').value.trim() || undefined,
      };
      const days = parseInt(params.get('d') || '', 10);
      if (Number.isFinite(days)) properties.days_since_install = days;

      try {
        if (!posthogApiKey || posthogApiKey.indexOf('REPLACE') !== -1) {
          throw new Error('PostHog API key is not configured');
        }
        const response = await fetch(`${posthogHost}/i/v0/e/`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            api_key: posthogApiKey,
            event: 'uninstall_survey_submitted',
            distinct_id: `survey-${crypto.randomUUID()}`,
            properties,
          }),
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        showThanks();
      } catch (error) {
        console.error('[Ophel] Uninstall survey submit failed:', error);
        errorEl.hidden = false;
        btn.disabled = false;
        btn.textContent = s.submit;
      }
    });

    applyLang(lang);
  </script>
</BaseLayout>

<style>
  .uninstall-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48px 20px 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 800;
    color: var(--ink-strong);
    margin-bottom: 20px;
  }

  .brand img {
    border-radius: 7px;
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  .card {
    width: 100%;
    max-width: 560px;
    background: var(--paper-strong);
    border-radius: 12px;
    box-shadow: var(--shadow-card);
    padding: 36px 36px 24px;
    animation: card-in 0.32s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  h1 {
    font-size: 26px;
    font-weight: 800;
    color: var(--ink-strong);
    margin: 0 0 10px;
  }

  .sub {
    color: var(--text-muted);
    font-size: 15px;
    line-height: 1.65;
    margin: 0;
  }

  .question {
    margin-top: 30px;
  }

  h2 {
    font-size: 15px;
    font-weight: 700;
    color: var(--ink-strong);
    margin: 0 0 10px;
  }

  .reasons {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .reason {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 9px 12px;
    border: 1px solid transparent;
    border-radius: 8px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink);
    cursor: pointer;
    transition:
      background-color 0.14s ease,
      border-color 0.14s ease;
  }

  .reason:hover {
    background: var(--surface-hover);
  }

  /* 选中态：浅青底 + 青边；默认态已有 1px 透明边，切换不位移 */
  .reason:has(input:checked) {
    background: var(--surface-tint);
    border-color: var(--accent);
  }

  .reason:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .reason input {
    width: 16px;
    height: 16px;
    flex: none;
    margin-top: 3px;
    accent-color: var(--accent);
    cursor: pointer;
  }

  .reason span {
    overflow-wrap: break-word;
    min-width: 0;
  }

  textarea {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper);
    padding: 10px 12px;
    font: inherit;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink);
    resize: vertical;
    min-height: 72px;
    transition: border-color 0.14s ease;
  }

  textarea::placeholder {
    color: var(--text-faint);
  }

  textarea:focus {
    outline: 2px solid var(--accent);
    outline-offset: 0;
    border-color: transparent;
  }

  .submit-btn {
    display: block;
    width: 100%;
    margin-top: 26px;
    padding: 13px;
    border: none;
    border-radius: 8px;
    background: var(--accent);
    color: #fff;
    font: inherit;
    font-weight: 700;
    font-size: 16px;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .submit-btn:hover {
    background: var(--accent-strong);
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .submit-btn:focus-visible,
  .skip-btn:focus-visible,
  select:focus-visible,
  .brand:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .form-error {
    margin: 12px 0 0;
    color: #b42318;
    font-size: 14px;
    line-height: 1.5;
  }

  /* 感谢态：本页唯一的主动效时刻 */
  @keyframes thanks-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @keyframes mark-pop {
    from {
      opacity: 0;
      transform: scale(0.55);
    }
  }

  #thanks-view {
    text-align: center;
    padding: 8px 0 4px;
    animation: thanks-in 0.32s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .success-mark {
    width: 48px;
    height: 48px;
    margin: 0 auto 14px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--ok);
    background: rgba(24, 121, 78, 0.12);
    animation: mark-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  #thanks-view h1 {
    margin-bottom: 12px;
  }

  #thanks-view .sub {
    max-width: 40ch;
    margin: 0 auto;
  }

  .card-footer {
    margin-top: 28px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .card-footer p {
    font-size: 13px;
    color: var(--text-faint);
    line-height: 1.6;
    max-width: 38ch;
    margin: 0;
  }

  .footer-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .skip-btn {
    background: none;
    border: none;
    padding: 4px;
    font: inherit;
    font-size: 13px;
    color: var(--text-faint);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .skip-btn:hover {
    color: var(--ink);
  }

  select {
    font: inherit;
    font-size: 13px;
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--paper);
    padding: 7px 10px;
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    #thanks-view,
    .success-mark {
      animation: none;
    }

    .reason,
    textarea,
    .submit-btn {
      transition: none;
    }
  }

  @media (max-width: 640px) {
    .uninstall-page {
      padding: 32px 14px 48px;
    }

    .card {
      padding: 26px 20px 20px;
    }

    h1 {
      font-size: 23px;
    }
  }
</style>
