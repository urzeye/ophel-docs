---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { uninstallSurveyI18n, type UninstallSurveyLang } from '../../i18n';

// ── PostHog 配置 ──────────────────────────────────────────────
// 在 PostHog 后台 Project Settings 复制 Project API Key（phc_ 开头，
// 该公钥设计为可在客户端公开），替换下面的占位值即可启用提交。
const POSTHOG_API_KEY = 'phc_q4eou3AFBafHUebahDH3DbGPEwA4fwwe8iEVcVUo7Exy';
// 按项目所在区域选择：https://us.i.posthog.com 或 https://eu.i.posthog.com
const POSTHOG_HOST = 'https://us.i.posthog.com';

const en = uninstallSurveyI18n.en;
const surveyStrings = uninstallSurveyI18n;
const reasonKeys = Object.keys(en.reasons) as (keyof typeof en.reasons)[];

// 语言选择器：标签用各语言原生名
const langOptions: { value: UninstallSurveyLang; label: string }[] = [
  { value: 'zh-CN', label: '简体中文' },
  { value: 'zh-TW', label: '繁體中文' },
  { value: 'en', label: 'English' },
  { value: 'ja', label: '日本語' },
  { value: 'ko', label: '한국어' },
  { value: 'it', label: 'Italiano' },
  { value: 'de', label: 'Deutsch' },
  { value: 'es', label: 'Español' },
  { value: 'fr', label: 'Français' },
  { value: 'pt', label: 'Português' },
  { value: 'ru', label: 'Русский' },
];
---

<BaseLayout
  title={en.metaTitle}
  description={en.metaDesc}
  lang="en"
  enPath="/uninstall/"
  zhPath="/uninstall/"
  robots="noindex, nofollow"
>
  <main id="main-content" class="uninstall-page">
    <a class="brand" href="/" data-home-link>
      <img src="/logo.png" alt="" width="30" height="30" />
      <span>Ophel</span>
    </a>

    <div class="card">
      <section id="survey-view">
        <p class="kicker" data-i18n="kicker">{en.kicker}</p>
        <h1 data-i18n="heading">{en.heading}</h1>
        <p class="sub" data-i18n="sub">{en.sub}</p>

        <form id="survey-form">
          <h2 data-i18n="reasonTitle">{en.reasonTitle}</h2>
          <div class="reasons" id="reasons">
            {
              reasonKeys.map((key) => (
                <label class="reason">
                  <input type="radio" name="reason" value={key} required />
                  <span>{en.reasons[key]}</span>
                </label>
              ))
            }
          </div>

          <h2 data-i18n="detailTitle">{en.detailTitle}</h2>
          <textarea id="detail" rows="3" maxlength="1000" placeholder={en.detailPlaceholder}
          ></textarea>

          <button type="submit" class="submit-btn" id="submit-btn">{en.submit}</button>
          <p class="form-error" id="form-error" hidden></p>
        </form>
      </section>

      <section id="thanks-view" hidden>
        <h1 data-i18n="thanksTitle">{en.thanksTitle}</h1>
        <p class="sub" data-i18n="thanksBody">{en.thanksBody}</p>
        <a class="submit-btn" id="reinstall-link" href="/download/">{en.reinstall}</a>
      </section>

      <div class="card-footer">
        <p data-i18n="footerNote">{en.footerNote}</p>
        <div class="footer-actions">
          <button type="button" class="skip-btn" id="skip-btn">{en.skip}</button>
          <select id="lang-select" aria-label="Language">
            {langOptions.map((option) => <option value={option.value}>{option.label}</option>)}
          </select>
        </div>
      </div>
    </div>
  </main>

  <script define:vars={{ surveyStrings, posthogApiKey: POSTHOG_API_KEY, posthogHost: POSTHOG_HOST }}
  >
    const params = new URLSearchParams(window.location.search);

    // l 参数来自 chrome.i18n.getUILanguage()（BCP-47 标签），映射到 11 种支持语言
    function resolveLang(raw) {
      const tag = String(raw || '').toLowerCase();
      if (tag.startsWith('zh')) {
        return tag.includes('tw') ||
          tag.includes('hk') ||
          tag.includes('mo') ||
          tag.includes('hant')
          ? 'zh-TW'
          : 'zh-CN';
      }
      const prefix = tag.split('-')[0];
      return Object.prototype.hasOwnProperty.call(surveyStrings, prefix) ? prefix : 'en';
    }

    let lang = resolveLang(params.get('l') || navigator.language);

    const el = (id) => document.getElementById(id);
    const strings = () => surveyStrings[lang] || surveyStrings.en;

    function applyLang(next) {
      lang = next;
      const s = strings();
      document.documentElement.lang = lang;
      document.title = s.metaTitle;
      document.querySelectorAll('[data-i18n]').forEach((node) => {
        const value = s[node.getAttribute('data-i18n')];
        if (typeof value === 'string') node.textContent = value;
      });
      document.querySelectorAll('#reasons .reason').forEach((label) => {
        const input = label.querySelector('input');
        const span = label.querySelector('span');
        const value = s.reasons[input.value];
        if (typeof value === 'string') span.textContent = value;
      });
      el('detail').placeholder = s.detailPlaceholder;
      el('submit-btn').textContent = s.submit;
      el('skip-btn').textContent = s.skip;
      el('reinstall-link').textContent = s.reinstall;
      el('reinstall-link').href = lang.startsWith('zh') ? '/zh/download/' : '/download/';
      el('form-error').textContent = s.error;
      el('lang-select').value = lang;
      document.querySelector('[data-home-link]').href = lang.startsWith('zh') ? '/zh/' : '/';

      const nextParams = new URLSearchParams(window.location.search);
      nextParams.set('l', lang);
      window.history.replaceState(null, '', `${window.location.pathname}?${nextParams.toString()}`);
    }

    function showThanks() {
      el('survey-view').hidden = true;
      el('thanks-view').hidden = false;
      el('skip-btn').hidden = true;
    }

    el('lang-select').addEventListener('change', (event) => applyLang(event.target.value));
    el('skip-btn').addEventListener('click', showThanks);

    el('survey-form').addEventListener('submit', async (event) => {
      event.preventDefault();
      const reason = new FormData(event.target).get('reason');
      if (!reason) return;

      const s = strings();
      const btn = el('submit-btn');
      const errorEl = el('form-error');
      btn.disabled = true;
      btn.textContent = s.submitting;
      errorEl.hidden = true;

      const properties = {
        $lib: 'web/uninstall-survey',
        v: params.get('v') || undefined,
        browser: params.get('b') || undefined,
        ui_language: lang,
        reason,
        comment: el('detail').value.trim() || undefined,
      };
      // i 是安装日的 epoch day（静态值，打开页面时换算最准）；d 是旧版写入的相对天数，仅作回退
      const installDay = parseInt(params.get('i') || '', 10);
      const fallbackDays = parseInt(params.get('d') || '', 10);
      if (Number.isFinite(installDay)) {
        properties.days_since_install = Math.max(0, Math.floor(Date.now() / 86400000) - installDay);
      } else if (Number.isFinite(fallbackDays)) {
        properties.days_since_install = fallbackDays;
      }

      try {
        if (!posthogApiKey || posthogApiKey.indexOf('REPLACE') !== -1) {
          throw new Error('PostHog API key is not configured');
        }
        const response = await fetch(`${posthogHost}/i/v0/e/`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            api_key: posthogApiKey,
            event: 'uninstall_survey_submitted',
            distinct_id: `survey-${crypto.randomUUID()}`,
            properties,
          }),
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        showThanks();
      } catch (error) {
        console.error('[Ophel] Uninstall survey submit failed:', error);
        errorEl.hidden = false;
        btn.disabled = false;
        btn.textContent = s.submit;
      }
    });

    applyLang(lang);
  </script>
</BaseLayout>

<style>
  .uninstall-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48px 20px 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 800;
    color: var(--ink-strong);
    margin-bottom: 24px;
  }

  .brand img {
    border-radius: 7px;
  }

  .card {
    width: 100%;
    max-width: 560px;
    background: var(--paper-strong);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: var(--shadow-card);
    padding: 32px 32px 20px;
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 8px;
  }

  h1 {
    font-size: 26px;
    font-weight: 800;
    color: var(--ink-strong);
    margin: 0 0 8px;
  }

  .sub {
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.6;
    margin: 0 0 8px;
  }

  h2 {
    font-size: 15px;
    font-weight: 700;
    color: var(--ink-strong);
    margin: 22px 0 8px;
  }

  .reasons {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .reason {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 10px;
    border-radius: 6px;
    font-size: 14px;
    color: var(--ink);
    cursor: pointer;
  }

  .reason:hover {
    background: var(--surface-hover);
  }

  .reason input {
    width: 16px;
    height: 16px;
    flex: none;
    accent-color: var(--accent);
    cursor: pointer;
  }

  textarea {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper);
    padding: 10px 12px;
    font: inherit;
    font-size: 14px;
    color: var(--ink);
    resize: vertical;
    min-height: 72px;
  }

  textarea:focus {
    outline: 2px solid var(--accent);
    border-color: transparent;
  }

  .submit-btn {
    display: block;
    width: 100%;
    margin-top: 20px;
    padding: 12px;
    border: none;
    border-radius: 8px;
    background: var(--accent);
    color: #fff;
    font: inherit;
    font-weight: 700;
    font-size: 15px;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .submit-btn:hover {
    background: var(--accent-strong);
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .form-error {
    margin: 10px 0 0;
    color: #b42318;
    font-size: 13px;
  }

  #thanks-view h1 {
    margin-bottom: 10px;
  }

  .card-footer {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .card-footer p {
    font-size: 13px;
    color: var(--text-faint);
    line-height: 1.6;
    max-width: 34ch;
    margin: 0;
  }

  .footer-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .skip-btn {
    background: none;
    border: none;
    padding: 4px;
    font: inherit;
    font-size: 13px;
    color: var(--text-faint);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .skip-btn:hover {
    color: var(--ink);
  }

  select {
    font: inherit;
    font-size: 13px;
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--paper);
    padding: 6px 8px;
  }

  @media (max-width: 640px) {
    .card {
      padding: 24px 20px 16px;
    }
  }
</style>
