---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** 当前页面语言，默认 zh-CN；英文版上线后传 'en' */
  lang?: string;
  /** 当前页面对应的英文路径（用于 hreflang），默认为当前路径 */
  enPath?: string;
  /** 当前页面对应的中文路径（用于 hreflang），默认 /zh + 当前路径 */
  zhPath?: string;
  /** 是否输出 JSON-LD SoftwareApplication 结构化数据，仅首页需要 */
  withJsonLd?: boolean;
}

const {
  title = 'Ophel — AI Chat Organizer & Outline Navigator',
  description = 'Ophel transforms AI chats into readable, navigable knowledge. Real-time outlines, conversation folders & prompt library for ChatGPT, Gemini, Claude and 15 platforms.',
  ogImage = '/og-image.png',
  lang = 'en',
  enPath,
  zhPath,
  withJsonLd = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// hreflang — 英文版上线前用占位 URL；上线后两个版本均会真实存在
const enURL = new URL(enPath ?? Astro.url.pathname.replace(/^\/zh(\/|$)/, '/'), Astro.site);
const zhURL = new URL(
  zhPath ?? `/zh${Astro.url.pathname === '/' ? '/' : Astro.url.pathname}`,
  Astro.site,
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Ophel',
  alternateName: 'Ophel Atlas',
  applicationCategory: 'BrowserApplication',
  applicationSubCategory: 'ProductivityApplication',
  operatingSystem: 'Chrome, Firefox, Edge',
  softwareVersion: '1.0.47',
  url: 'https://ophel.app',
  description:
    'Transform AI conversations into readable, navigable, and reusable knowledge. Supports ChatGPT, Gemini, Claude, and 15 platforms.',
  screenshot: 'https://ophel.app/og-image.png',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  author: {
    '@type': 'Organization',
    name: 'Ophel',
    url: 'https://ophel.app',
  },
  sameAs: [
    'https://github.com/urzeye/ophel',
    'https://chromewebstore.google.com/detail/ophel-ai-%E5%AF%B9%E8%AF%9D%E5%A2%9E%E5%BC%BA%E5%B7%A5%E5%85%B7/lpcohdfbomkgepfladogodgeoppclakd',
    'https://addons.mozilla.org/zh-CN/firefox/addon/ophel-ai-chat-enhancer/',
    'https://greasyfork.org/zh-CN/scripts/563646-ophel-ai-chat-page-enhancer',
  ],
};
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <!-- 让浏览器立即用深色背景渲染，避免白闪 (CLS) -->
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0f" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="qlpmLkZCADw3RM8CMlxMIe_4xXFMX3GVT-1WGf2vpX8" />
    <link rel="canonical" href={canonicalURL} />

    <!-- hreflang — 多语言占位（英文版上线后两个链接均指向真实页面） -->
    <link rel="alternate" hreflang="x-default" href={enURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="zh-CN" href={zhURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ophel" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={lang === 'zh-CN' ? 'zh_CN' : 'en_US'} />
    {lang === 'zh-CN' && <meta property="og:locale:alternate" content="en_US" />}
    {lang !== 'zh-CN' && <meta property="og:locale:alternate" content="zh_CN" />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@urzeyeVirgo" />
    <meta name="twitter:creator" content="@urzeyeVirgo" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Favicon & Touch Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Google Fonts — 异步加载，避免阻塞渲染 (FCP/LCP) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- preload CSS 文件本身，让浏览器提前发现字体请求 -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700&display=swap"
    />
    <!-- media=print 技巧：CSS 不阻塞渲染，onload 后切换为 all -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <!-- 无 JS 兜底 -->
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700&display=swap"
      />
    </noscript>

    <!-- JSON-LD 结构化数据（仅首页） -->
    {withJsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <slot />
  </body>
</html>

