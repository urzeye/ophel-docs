---
import '../styles/global.css';
import { getLatestVersion } from '../lib/changelog';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  lang?: string;
  enPath?: string;
  zhPath?: string;
  withJsonLd?: boolean;
}

const {
  title = 'Ophel Atlas — AI Chat Outline, Folder Organizer & Prompt Workbench',
  description = 'Ophel transforms AI chats into readable, navigable knowledge. Real-time outlines, chat folders & prompt library across 16 built-in platforms and 16 hot-swappable Site Packs.',
  ogImage = '/og-image.png',
  lang = 'en',
  enPath,
  zhPath,
  withJsonLd = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const enURL = new URL(enPath ?? Astro.url.pathname.replace(/^\/zh(\/|$)/, '/'), Astro.site);
const zhURL = new URL(
  zhPath ?? `/zh${Astro.url.pathname === '/' ? '/' : Astro.url.pathname}`,
  Astro.site,
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Ophel',
  alternateName: 'Ophel Atlas',
  applicationCategory: 'BrowserApplication',
  applicationSubCategory: 'ProductivityApplication',
  operatingSystem: 'Chrome, Edge, Firefox, Safari, Tampermonkey',
  softwareVersion: getLatestVersion() || '1.3.2',
  url: 'https://ophel.app',
  description:
    'Transform AI conversations into readable, navigable, and reusable knowledge across 16 built-in platforms (including ChatGPT, Gemini, Claude, Gemini Notebook) and 16 hot-swappable Site Packs.',
  screenshot: 'https://ophel.app/og-image.png',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  author: {
    '@type': 'Organization',
    name: 'Ophel',
    url: 'https://ophel.app',
  },
  sameAs: [
    'https://github.com/urzeye/ophel',
    'https://chromewebstore.google.com/detail/ai-chat-organizer-outline/lpcohdfbomkgepfladogodgeoppclakd',
    'https://microsoftedge.microsoft.com/addons/detail/ophel-atlas-ai-chat-navi/ffpenkdeifijngifjmbbpijfpdhlolga',
    'https://addons.mozilla.org/firefox/addon/ophel-ai-chat-enhancer/',
    'https://greasyfork.org/scripts/563646-ophel-ai-chat-page-enhancer',
  ],
};

const fontUrl =
  'https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Public+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&display=swap';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f5efe4" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="qlpmLkZCADw3RM8CMlxMIe_4xXFMX3GVT-1WGf2vpX8" />
    <link rel="canonical" href={canonicalURL} />

    <link rel="alternate" hreflang="x-default" href={enURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="zh-CN" href={zhURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ophel" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={lang === 'zh-CN' ? 'zh_CN' : 'en_US'} />
    {lang === 'zh-CN' && <meta property="og:locale:alternate" content="en_US" />}
    {lang !== 'zh-CN' && <meta property="og:locale:alternate" content="zh_CN" />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@urzeyeVirgo" />
    <meta name="twitter:creator" content="@urzeyeVirgo" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Favicon & Touch Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Google Fonts — 异步加载，避免阻塞渲染 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={fontUrl} />
    <link rel="stylesheet" href={fontUrl} media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href={fontUrl} />
    </noscript>

    {withJsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <slot />
  </body>
</html>
