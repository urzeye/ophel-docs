---
import type { T } from '../i18n';
import { CHROME_STORE_URL } from '../i18n';

interface Props {
  t: T['nav'];
  homeHref?: string;
}

const { t, homeHref = '/' } = Astro.props;

const navLinks = [
  { label: t.features, href: homeHref + '#features' },
  { label: t.platforms, href: homeHref + '#platforms' },
  { label: t.docs, href: t.docsHref },
  { label: t.changelog, href: t.changelogHref },
];
---

<header
  class="sticky top-0 z-50 w-full border-b border-white/5 bg-background/60 backdrop-blur-xl supports-[backdrop-filter]:bg-background/50"
>
  <div class="w-full max-w-6xl mx-auto px-6">
    <div class="flex h-16 items-center justify-between">
      <div class="flex items-center gap-8">
        <a
          href={homeHref}
          class="flex items-center gap-2.5 transition-opacity hover:opacity-80"
          aria-label={t.homeLabel}
        >
          <img
            src="/logo.png"
            alt="Ophel logo"
            width="28"
            height="28"
            class="rounded-md"
            aria-hidden="true"
          />
          <span class="text-lg font-bold tracking-tight text-white">Ophel</span>
        </a>

        <nav class="hidden md:flex items-center gap-2" aria-label={t.ariaLabel}>
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="px-3 py-1.5 text-sm font-medium text-zinc-400 rounded-lg hover:text-white hover:bg-white/5 transition-all"
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>

      <div class="flex items-center gap-4">
        <a
          href={t.langSwitchHref}
          class="hidden sm:flex px-3 py-1.5 text-xs font-medium text-zinc-400 bg-surface border border-surface-border rounded-md hover:text-white hover:bg-surface-hover hover:border-white/20 transition-all"
          aria-label={t.langSwitchAriaLabel}
        >
          {t.langSwitch}
        </a>
        <a
          href={t.installHref}
          class="relative inline-flex h-9 items-center justify-center rounded-md bg-white px-5 py-2 text-sm font-semibold text-[#000] transition-colors hover:bg-zinc-200"
        >
          {t.install}
        </a>
      </div>
    </div>
  </div>
</header>
