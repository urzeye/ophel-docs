---
import type { T } from '../i18n';
import { CHROME_STORE_URL } from '../i18n';

interface Props {
  t: T['nav'];
  homeHref?: string;
}

const { t, homeHref = '/' } = Astro.props;

const navLinks = [
  { label: t.features, href: homeHref + '#features' },
  { label: t.reviews, href: t.reviewsHref },
  { label: t.platforms, href: homeHref + '#platforms' },
  { label: t.changelog, href: t.changelogHref },
  { label: t.docs, href: t.docsHref },
];
---

<header class="site-nav">
  <div class="w-full max-w-[1180px] mx-auto px-5 sm:px-6 lg:px-8">
    <div class="flex h-[72px] items-center justify-between">
      <div class="flex items-center gap-8">
        <a
          href={homeHref}
          class="flex items-center gap-2.5 rounded-full pr-2 transition-opacity hover:opacity-80"
          aria-label={t.homeLabel}
        >
          <img src="/logo.png" alt="Ophel logo" width="32" height="32" class="rounded-lg" />
          <span class="text-lg font-extrabold tracking-tight text-[color:var(--ink)]">Ophel</span>
        </a>

        <nav class="hidden md:flex items-center gap-2" aria-label={t.ariaLabel}>
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="rounded-full px-3.5 py-2 text-sm font-semibold text-[color:var(--ink-muted)] transition-all hover:bg-[color:var(--surface)] hover:text-[color:var(--ink)]"
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>

      <div class="flex items-center gap-4">
        <a
          href={t.langSwitchHref}
          class="hidden rounded-full border border-[color:var(--line)] bg-white/70 px-3.5 py-2 text-xs font-bold text-[color:var(--ink-muted)] shadow-[0_8px_24px_rgba(28,45,74,0.06)] transition-all hover:border-[color:var(--line-strong)] hover:text-[color:var(--ink)] sm:flex"
          aria-label={t.langSwitchAriaLabel}
        >
          {t.langSwitch}
        </a>
        <a
          href={t.installHref}
          class="relative inline-flex h-10 items-center justify-center rounded-full bg-[color:var(--ink)] px-5 py-2 text-sm font-bold text-white shadow-[0_14px_32px_rgba(20,34,58,0.2)] transition-all hover:-translate-y-0.5 hover:bg-[color:var(--ink-strong)]"
        >
          {t.install}
        </a>
      </div>
    </div>
  </div>
</header>
