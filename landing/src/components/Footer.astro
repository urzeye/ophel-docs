---
import type { T } from '../i18n';

interface Props {
  t: T['footer'];
}

const { t } = Astro.props;
---

<footer class="border-t border-white/10 bg-background py-12 md:py-16">
  <div class="w-full max-w-6xl mx-auto px-6">
    <div class="grid gap-8 md:grid-cols-4 lg:grid-cols-5">
      <div class="col-span-2">
        <a href="/" class="mb-4 inline-flex items-center gap-2">
          <img src="/logo.png" alt="Ophel logo" width="28" height="28" class="rounded-md" />
          <span class="text-lg font-bold text-white">Ophel</span>
        </a>
        <p class="text-sm leading-relaxed text-zinc-400 max-w-sm">
          {t.desc}
        </p>
      </div>

      <div>
        <h3 class="mb-4 text-sm font-semibold text-white">{t.product}</h3>
        <ul class="space-y-3 text-sm text-zinc-400">
          <li>
            <a href={t.links.downloadHref} class="hover:text-neon-cyan transition-colors"
              >{t.links.download}</a
            >
          </li>
          <li>
            <a href={t.links.changelogHref} class="hover:text-neon-cyan transition-colors"
              >{t.links.changelog}</a
            >
          </li>
          <li>
            <a href={t.links.docsHref} class="hover:text-neon-cyan transition-colors"
              >{t.links.docs}</a
            >
          </li>
        </ul>
      </div>

      <div>
        <h3 class="mb-4 text-sm font-semibold text-white">{t.support}</h3>
        <ul class="space-y-3 text-sm text-zinc-400">
          <li>
            <a
              href={t.links.githubHref}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-neon-cyan transition-colors"
            >
              {t.links.github}
            </a>
          </li>
          <li>
            <a
              href={t.links.issueHref}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-neon-cyan transition-colors"
            >
              {t.links.issue}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="mb-4 text-sm font-semibold text-white">{t.legal}</h3>
        <ul class="space-y-3 text-sm text-zinc-400">
          <li>
            <a href={t.links.privacyHref} class="hover:text-neon-cyan transition-colors"
              >{t.links.privacy}</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col items-center justify-between border-t border-white/5 pt-8 sm:flex-row"
    >
      <p class="text-sm text-zinc-500">
        © {new Date().getFullYear()} Ophel. {t.rights}.
      </p>
      <div class="mt-4 flex gap-4 sm:mt-0 text-zinc-500 text-sm"></div>
    </div>
  </div>
</footer>
