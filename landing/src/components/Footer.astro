---
import type { T } from '../i18n';

interface Props {
  t: T['footer'];
}

const { t } = Astro.props;
---

<footer class="border-t border-white/10 bg-background py-12 md:py-16">
  <div class="w-full max-w-6xl mx-auto px-6">
    <div class="grid gap-8 md:grid-cols-4 lg:grid-cols-5">
      <div class="col-span-2">
        <a href="/" class="mb-4 inline-flex items-center gap-2">
          <svg width="24" height="24" viewBox="0 0 28 28" fill="none" aria-hidden="true">
            <rect width="28" height="28" rx="6" fill="#000" stroke="rgba(0, 240, 255, 0.5)" stroke-width="1.5"></rect>  
            <path d="M8 14a6 6 0 1 1 12 0A6 6 0 0 1 8 14Z" fill="#00f0ff" opacity="0.9"></path>
            <circle cx="14" cy="14" r="2.5" fill="#000"></circle>
          </svg>
          <span class="text-lg font-bold text-white">Ophel</span>
        </a>
        <p class="text-sm leading-relaxed text-zinc-400 max-w-sm">
          {t.desc}
        </p>
      </div>

      <div>
        <h3 class="mb-4 text-sm font-semibold text-white">{t.product}</h3>
        <ul class="space-y-3 text-sm text-zinc-400">
          <li><a href={t.links.downloadHref} class="hover:text-neon-cyan transition-colors">{t.links.download}</a></li>
          <li><a href={t.links.changelogHref} class="hover:text-neon-cyan transition-colors">{t.links.changelog}</a></li>
          <li><a href={t.links.docsHref} class="hover:text-neon-cyan transition-colors">{t.links.docs}</a></li>
        </ul>
      </div>

      <div>
        <h3 class="mb-4 text-sm font-semibold text-white">{t.support}</h3>
        <ul class="space-y-3 text-sm text-zinc-400">
          <li>
            <a href={t.links.githubHref} target="_blank" rel="noopener noreferrer" class="hover:text-neon-cyan transition-colors">
              {t.links.github}
            </a>
          </li>
          <li>
            <a href={t.links.issueHref} target="_blank" rel="noopener noreferrer" class="hover:text-neon-cyan transition-colors">
              {t.links.issue}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="mb-4 text-sm font-semibold text-white">{t.legal}</h3>
        <ul class="space-y-3 text-sm text-zinc-400">
          <li><a href={t.links.privacyHref} class="hover:text-neon-cyan transition-colors">{t.links.privacy}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between border-t border-white/5 pt-8 sm:flex-row">
      <p class="text-sm text-zinc-500">
        © {new Date().getFullYear()} Ophel. {t.rights}.
      </p>
      <div class="mt-4 flex gap-4 sm:mt-0 text-zinc-500 text-sm">
      </div>
    </div>
  </div>
</footer>
