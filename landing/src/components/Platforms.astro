---
import type { T } from '../i18n';

import { getSupportedPlatforms, type SupportedPlatformLocale } from '../lib/supported-platforms';

interface Props {
  t: T['platforms'];
  locale?: SupportedPlatformLocale;
}

const { t, locale = 'en' } = Astro.props;

const allPlatforms = getSupportedPlatforms(locale);
const platformRow1 = allPlatforms.slice(0, 6);
const platformRow2 = allPlatforms.slice(6);
---

<section class="platforms" id="platforms">
  <div class="section-inner">
    <div class="section-header">
      <h2 class="section-title">{t.title}</h2>
      <p class="section-desc">{t.desc}</p>
    </div>

    <div class="platform-rows-container">
      <div class="platform-row">
        {
          platformRow1.map((platform) => (
            <a
              class="platform-chip"
              href={platform.href}
              target="_blank"
              rel="noopener noreferrer"
              title={platform.href}
              aria-label={`${platform.label} (${platform.href})`}
            >
              <span
                class={`platform-chip-icon ${platform.iconVariant === 'inverted' ? 'platform-chip-icon-inverted' : ''}`}
                aria-hidden="true"
              >
                {platform.iconSrc ? (
                  <img src={platform.iconSrc} alt="" loading="lazy" />
                ) : (
                  <span>{platform.emoji}</span>
                )}
              </span>
              <span class="platform-chip-label">{platform.label}</span>
            </a>
          ))
        }
      </div>
      <div class="platform-row">
        {
          platformRow2.map((platform) => (
            <a
              class="platform-chip"
              href={platform.href}
              target="_blank"
              rel="noopener noreferrer"
              title={platform.href}
              aria-label={`${platform.label} (${platform.href})`}
            >
              <span
                class={`platform-chip-icon ${platform.iconVariant === 'inverted' ? 'platform-chip-icon-inverted' : ''}`}
                aria-hidden="true"
              >
                {platform.iconSrc ? (
                  <img src={platform.iconSrc} alt="" loading="lazy" />
                ) : (
                  <span>{platform.emoji}</span>
                )}
              </span>
              <span class="platform-chip-label">{platform.label}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .platforms {
    padding: var(--section-gap) 24px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(124, 111, 255, 0.04) 50%,
      transparent 100%
    );
  }

  .section-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .section-title {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }

  .section-desc {
    font-size: 17px;
    color: var(--color-text-muted);
  }

  .platform-rows-container {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: center;
    max-width: 1000px;
    margin: 0 auto;
  }

  .platform-row {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    gap: 10px;
  }

  .platform-chip {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    padding: 0 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    color: var(--color-text-muted);
    text-decoration: none;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 2px 8px rgba(0, 0, 0, 0.18);
    transition:
      transform 0.18s ease,
      color 0.18s ease,
      border-color 0.18s ease,
      background 0.18s ease,
      box-shadow 0.18s ease;
  }

  .platform-chip:hover {
    color: var(--color-text);
    border-color: rgba(124, 111, 255, 0.45);
    background: rgba(124, 111, 255, 0.1);
    transform: translateY(-2px);
    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  .platform-chip:focus-visible {
    outline: 2px solid rgba(124, 111, 255, 0.65);
    outline-offset: 2px;
  }

  .platform-chip-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }

  .platform-chip-icon img {
    width: 18px;
    height: 18px;
    object-fit: contain;
    display: block;
  }

  .platform-chip-icon-inverted {
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
  }

  .platform-chip-icon-inverted img {
    width: 16px;
    height: 16px;
    filter: brightness(0) invert(1);
  }

  .platform-chip-label {
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .platform-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
