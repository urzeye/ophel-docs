---
import type { T } from '../i18n';

import { getSupportedPlatforms, type SupportedPlatformLocale } from '../lib/supported-platforms';

interface Props {
  t: T['platforms'];
  locale?: SupportedPlatformLocale;
}

const { t, locale = 'en' } = Astro.props;

const allPlatforms = getSupportedPlatforms(locale);
const platformRow1 = allPlatforms.slice(0, 6);
const platformRow2 = allPlatforms.slice(6);
---

<section class="platforms" id="platforms">
  <div class="section-inner">
    <div class="section-header">
      <h2 class="section-title">{t.title}</h2>
      <p class="section-desc">{t.desc}</p>
    </div>

    <div class="platform-rows-container">
      <div class="platform-row">
        {
          platformRow1.map((platform) => (
            <a
              class="platform-chip"
              href={platform.href}
              target="_blank"
              rel="noopener noreferrer"
              title={platform.href}
              aria-label={`${platform.label} (${platform.href})`}
            >
              <span
                class={`platform-chip-icon ${platform.iconVariant === 'inverted' ? 'platform-chip-icon-inverted' : ''}`}
                aria-hidden="true"
              >
                {platform.iconSrc ? (
                  <img src={platform.iconSrc} alt={`${platform.label} logo`} loading="lazy" />
                ) : (
                  <span>{platform.emoji}</span>
                )}
              </span>
              <span class="platform-chip-label">{platform.label}</span>
            </a>
          ))
        }
      </div>
      <div class="platform-row">
        {
          platformRow2.map((platform) => (
            <a
              class="platform-chip"
              href={platform.href}
              target="_blank"
              rel="noopener noreferrer"
              title={platform.href}
              aria-label={`${platform.label} (${platform.href})`}
            >
              <span
                class={`platform-chip-icon ${platform.iconVariant === 'inverted' ? 'platform-chip-icon-inverted' : ''}`}
                aria-hidden="true"
              >
                {platform.iconSrc ? (
                  <img src={platform.iconSrc} alt={`${platform.label} logo`} loading="lazy" />
                ) : (
                  <span>{platform.emoji}</span>
                )}
              </span>
              <span class="platform-chip-label">{platform.label}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
