---
import type { T } from '../i18n';

interface Props {
  t: T['platforms'];
}

const { t } = Astro.props;

const platforms = [
  'ChatGPT',
  'Gemini',
  'Claude',
  'Grok',
  'AI Studio',
  'DeepSeek',
  'Doubao',
  'Kimi',
  'QwenAI',
  'Qianwen',
  'Yuanbao',
  'Z.ai',
  'ChatGLM',
  'Ima',
  'Gemini Enterprise',
];
---

<section class="platforms" id="platforms">
  <div class="section-inner">
    <div class="section-header">
      <h2 class="section-title">{t.title}</h2>
      <p class="section-desc">{t.desc}</p>
    </div>

    <div class="platform-grid">
      {platforms.map((name) => <div class="platform-chip">{name}</div>)}
    </div>
  </div>
</section>

<style>
  .platforms {
    padding: var(--section-gap) 24px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(124, 111, 255, 0.04) 50%,
      transparent 100%
    );
  }

  .section-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .section-title {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }

  .section-desc {
    font-size: 17px;
    color: var(--color-text-muted);
  }

  .platform-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .platform-chip {
    padding: 8px 20px;
    border-radius: 100px;
    font-size: 14px;
    font-weight: 500;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    transition:
      color 0.15s,
      border-color 0.15s;
  }

  .platform-chip:hover {
    color: var(--color-text);
    border-color: rgba(124, 111, 255, 0.4);
  }
</style>
