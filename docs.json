{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Ophel Atlas",
  "theme": "luma",
  "colors": {
    "primary": "#1967D2",
    "light": "#EBF2FF",
    "dark": "#3367D6"
  },
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg",
    "href": "https://ophel.app"
  },
  "favicon": "/images/logo.png",
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "heading": {
      "family": "Inter"
    },
    "body": {
      "family": "Inter"
    }
  },
  "background": {
    "decoration": "gradient"
  },
  "interaction": {
    "drilldown": true
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "light": "github-light",
      "dark": "github-dark"
    }
  },
  "thumbnails": {
    "appearance": "light"
  },
  "navbar": {
    "links": [
      {
        "label": " ",
        "href": "https://discord.gg/rmPzb6Cx9u",
        "icon": {
          "style": "brands",
          "name": "discord"
        }
      },
      {
        "label": " ",
        "href": "https://ko-fi.com/urzeye",
        "icon": "mug-hot"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/urzeye/ophel"
    }
  },
  "description": "Ophel Atlas is a browser extension and userscript that turns AI chats into navigable, structured documents. Supports 16 built-in platforms and community Site Packs.",
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "Ophel Atlas Docs",
      "og:type": "website",
      "og:image": "https://ophel.app/images/og-cover.png",
      "og:image:width": "1280",
      "og:image:height": "640",
      "og:image:type": "image/png",
      "twitter:card": "summary_large_image",
      "twitter:site": "@urzeyeVirgo",
      "twitter:creator": "@urzeyeVirgo",
      "twitter:image": "https://ophel.app/images/og-cover.png"
    }
  },
  "redirects": [
    {
      "source": "/introduction",
      "destination": "/"
    },
    {
      "source": "/zh/introduction",
      "destination": "/zh"
    },
    {
      "source": "/data/migration",
      "destination": "/data/backup-sync"
    },
    {
      "source": "/zh/data/migration",
      "destination": "/zh/data/backup-sync"
    },
    {
      "source": "/site-packs",
      "destination": "/enhancements/site-extensions"
    },
    {
      "source": "/site-packs/installation",
      "destination": "/enhancements/site-extensions/installation"
    },
    {
      "source": "/site-packs/capabilities",
      "destination": "/enhancements/site-extensions/capabilities"
    },
    {
      "source": "/site-packs/authoring",
      "destination": "/enhancements/site-extensions/authoring"
    },
    {
      "source": "/site-packs/faq",
      "destination": "/enhancements/site-extensions/faq"
    },
    {
      "source": "/zh/site-packs",
      "destination": "/zh/enhancements/site-extensions"
    },
    {
      "source": "/zh/site-packs/installation",
      "destination": "/zh/enhancements/site-extensions/installation"
    },
    {
      "source": "/zh/site-packs/capabilities",
      "destination": "/zh/enhancements/site-extensions/capabilities"
    },
    {
      "source": "/zh/site-packs/authoring",
      "destination": "/zh/enhancements/site-extensions/authoring"
    },
    {
      "source": "/zh/site-packs/faq",
      "destination": "/zh/enhancements/site-extensions/faq"
    }
  ],
  "search": {
    "prompt": "Search docs..."
  },
  "metadata": {
    "timestamp": true
  },
  "contextual": {
    "options": ["assistant", "copy"],
    "display": "toc"
  },
  "footer": {
    "socials": {
      "github": "https://github.com/urzeye/ophel",
      "discord": "https://discord.gg/rmPzb6Cx9u",
      "x": "https://x.com/urzeyeVirgo"
    },
    "links": [
      {
        "header": "Install",
        "items": [
          {
            "label": "Chrome Web Store",
            "href": "https://chromewebstore.google.com/detail/ai-chat-organizer-outline/lpcohdfbomkgepfladogodgeoppclakd"
          },
          {
            "label": "Microsoft Edge Add-ons",
            "href": "https://microsoftedge.microsoft.com/addons/detail/ophel-atlas-ai-chat-navi/ffpenkdeifijngifjmbbpijfpdhlolga"
          },
          {
            "label": "Firefox Add-ons",
            "href": "https://addons.mozilla.org/firefox/addon/ophel-ai-chat-enhancer/"
          },
          {
            "label": "Greasy Fork",
            "href": "https://greasyfork.org/scripts/563646-ophel-ai-chat-page-enhancer"
          },
          {
            "label": "ScriptCat",
            "href": "https://scriptcat.org/script-show-page/6519"
          },
          {
            "label": "GitHub Releases",
            "href": "https://github.com/urzeye/ophel/releases"
          }
        ]
      },
      {
        "header": "Connect",
        "items": [
          {
            "label": "Discord",
            "href": "https://discord.gg/rmPzb6Cx9u"
          },
          {
            "label": "Ko-fi",
            "href": "https://ko-fi.com/urzeye"
          },
          {
            "label": "Linux.do",
            "href": "https://linux.do/u/urzeye"
          }
        ]
      },
      {
        "header": "Resources",
        "items": [
          {
            "label": "GitHub",
            "href": "https://github.com/urzeye/ophel"
          },
          {
            "label": "Issues",
            "href": "https://github.com/urzeye/ophel/issues"
          },
          {
            "label": "Changelog",
            "href": "https://github.com/urzeye/ophel/blob/main/CHANGELOG.md"
          }
        ]
      }
    ]
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "tabs": [
          {
            "tab": "Docs",
            "icon": "book-open",
            "groups": [
              {
                "group": "Get Started",
                "icon": "rocket",
                "pages": ["index", "installation", "panel-overview"]
              },
              {
                "group": "Core Features",
                "icon": "star",
                "pages": [
                  "features/outline",
                  {
                    "group": "Chat Management",
                    "icon": "folder-open",
                    "root": "features/conversations",
                    "expanded": true,
                    "pages": ["features/export"]
                  },
                  "features/prompts",
                  "features/global-search"
                ]
              },
              {
                "group": "Enhancements",
                "icon": "sparkles",
                "pages": [
                  "enhancements/reading",
                  "enhancements/content",
                  "enhancements/tab-notifications",
                  {
                    "group": "Site Packs",
                    "icon": "/images/icons/site-packs.svg",
                    "expanded": false,
                    "pages": [
                      "enhancements/site-extensions/index",
                      "enhancements/site-extensions/installation",
                      "enhancements/site-extensions/faq",
                      {
                        "group": "For Pack Authors",
                        "icon": "code",
                        "expanded": false,
                        "pages": [
                          "enhancements/site-extensions/capabilities",
                          "enhancements/site-extensions/authoring"
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "group": "Customization",
                "icon": "/images/icons/appearance.svg",
                "pages": [
                  "customization/appearance",
                  "customization/layout",
                  "customization/site-settings",
                  "customization/shortcuts"
                ]
              },
              {
                "group": "Data & Privacy",
                "icon": "shield",
                "pages": [
                  "data/backup-sync",
                  "data/webdav",
                  "data/privacy",
                  "data/permissions"
                ]
              },
              {
                "group": "Help",
                "icon": "circle-question",
                "pages": ["faq", "troubleshooting"]
              }
            ]
          },
          {
            "tab": "Installation",
            "icon": "arrow-down-to-line",
            "groups": [
              {
                "group": "Installation",
                "pages": ["installation"]
              }
            ]
          },
          {
            "tab": "Changelog",
            "icon": "list",
            "groups": [
              {
                "group": "Changelog",
                "pages": ["changelog"]
              }
            ]
          }
        ]
      },
      {
        "language": "zh",
        "tabs": [
          {
            "tab": "文档",
            "icon": "book-open",
            "groups": [
              {
                "group": "快速开始",
                "icon": "rocket",
                "pages": [
                  "zh/index",
                  "zh/installation",
                  "zh/panel-overview"
                ]
              },
              {
                "group": "核心功能",
                "icon": "star",
                "pages": [
                  "zh/features/outline",
                  {
                    "group": "对话管理",
                    "icon": "folder-open",
                    "root": "zh/features/conversations",
                    "expanded": true,
                    "pages": ["zh/features/export"]
                  },
                  "zh/features/prompts",
                  "zh/features/global-search"
                ]
              },
              {
                "group": "体验增强",
                "icon": "sparkles",
                "pages": [
                  "zh/enhancements/reading",
                  "zh/enhancements/content",
                  "zh/enhancements/tab-notifications",
                  {
                    "group": "适配中心",
                    "icon": "/images/icons/site-packs.svg",
                    "expanded": false,
                    "pages": [
                      "zh/enhancements/site-extensions/index",
                      "zh/enhancements/site-extensions/installation",
                      "zh/enhancements/site-extensions/faq",
                      {
                        "group": "适配包编写与参考",
                        "icon": "code",
                        "expanded": false,
                        "pages": [
                          "zh/enhancements/site-extensions/capabilities",
                          "zh/enhancements/site-extensions/authoring"
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "group": "个性化与站点设置",
                "icon": "/images/icons/appearance.svg",
                "pages": [
                  "zh/customization/appearance",
                  "zh/customization/layout",
                  "zh/customization/site-settings",
                  "zh/customization/shortcuts"
                ]
              },
              {
                "group": "数据与隐私",
                "icon": "shield",
                "pages": [
                  "zh/data/backup-sync",
                  "zh/data/webdav",
                  "zh/data/privacy",
                  "zh/data/permissions"
                ]
              },
              {
                "group": "帮助",
                "icon": "circle-question",
                "pages": ["zh/faq", "zh/troubleshooting"]
              }
            ]
          },
          {
            "tab": "安装",
            "icon": "arrow-down-to-line",
            "groups": [
              {
                "group": "安装",
                "pages": ["zh/installation"]
              }
            ]
          },
          {
            "tab": "更新日志",
            "icon": "list",
            "groups": [
              {
                "group": "更新日志",
                "pages": ["zh/changelog"]
              }
            ]
          }
        ]
      }
    ]
  }
}
