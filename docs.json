{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Ophel Atlas",
  "theme": "luma",
  "colors": {
    "primary": "#4285F4",
    "light": "#EBF2FF",
    "dark": "#1A2B4A"
  },
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg"
  },
  "favicon": "/images/logo.png",
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "heading": {
      "family": "Inter"
    },
    "body": {
      "family": "Inter"
    }
  },
  "background": {
    "decoration": "gradient"
  },
  "interaction": {
    "drilldown": true
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "light": "github-light",
      "dark": "github-dark"
    }
  },
  "thumbnails": {
    "appearance": "light"
  },
  "navbar": {
    "links": [
      {
        "label": "Discord",
        "href": "https://discord.gg/rmPzb6Cx9u",
        "icon": {
          "style": "brands",
          "name": "discord"
        }
      },
      {
        "label": "Ko-fi",
        "href": "https://ko-fi.com/urzeye",
        "icon": "mug-hot"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/urzeye/ophel"
    }
  },
  "description": "Ophel Atlas is a browser extension that transforms AI chat into navigable, structured knowledge. Supports ChatGPT, Gemini, Claude, DeepSeek, and 11 more platforms.",
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "Ophel Atlas Docs",
      "og:type": "website",
      "twitter:card": "summary_large_image",
      "twitter:site": "@urzeyeVirgo"
    }
  },
  "search": {
    "prompt": "Search docs..."
  },
  "metadata": {
    "timestamp": true
  },
  "contextual": {
    "options": [
      "assistant",
      "copy"
    ],
    "display": "toc"
  },
  "footer": {
    "socials": {
      "github": "https://github.com/urzeye/ophel",
      "discord": "https://discord.gg/rmPzb6Cx9u",
      "x": "https://x.com/urzeyeVirgo"
    },
    "links": [
      {
        "header": "Install",
        "items": [
          {
            "label": "Chrome Web Store",
            "href": "https://chromewebstore.google.com/detail/ophel-ai-%E5%AF%B9%E8%AF%9D%E5%A2%9E%E5%BC%BA%E5%B7%A5%E5%85%B7/lpcohdfbomkgepfladogodgeoppclakd"
          },
          {
            "label": "Firefox Add-ons",
            "href": "https://addons.mozilla.org/zh-CN/firefox/addon/ophel-ai-chat-enhancer/"
          },
          {
            "label": "Greasy Fork",
            "href": "https://greasyfork.org/zh-CN/scripts/563646-ophel-ai-chat-page-enhancer"
          },
          {
            "label": "GitHub Releases",
            "href": "https://github.com/urzeye/ophel/releases"
          }
        ]
      },
      {
        "header": "Connect",
        "items": [
          {
            "label": "Discord",
            "href": "https://discord.gg/rmPzb6Cx9u"
          },
          {
            "label": "Ko-fi",
            "href": "https://ko-fi.com/urzeye"
          },
          {
            "label": "Linux.do",
            "href": "https://linux.do/u/urzeye"
          }
        ]
      },
      {
        "header": "Resources",
        "items": [
          {
            "label": "GitHub",
            "href": "https://github.com/urzeye/ophel"
          },
          {
            "label": "Issues",
            "href": "https://github.com/urzeye/ophel/issues"
          },
          {
            "label": "Changelog",
            "href": "https://github.com/urzeye/ophel/blob/main/CHANGELOG.md"
          }
        ]
      }
    ]
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "tabs": [
          {
            "tab": "Docs",
            "icon": "book-open",
            "groups": [
              {
                "group": "Get Started",
                "icon": "rocket",
                "pages": [
                  "introduction",
                  "installation",
                  "panel-overview"
                ]
              },
              {
                "group": "Core Features",
                "icon": "star",
                "pages": [
                  "features/outline",
                  "features/conversations",
                  "features/prompts",
                  "features/global-search"
                ]
              },
              {
                "group": "Enhancements",
                "icon": "sparkles",
                "pages": [
                  "enhancements/reading",
                  "enhancements/content",
                  "enhancements/tab-notifications"
                ]
              },
              {
                "group": "Customization",
                "icon": "palette",
                "pages": [
                  "customization/appearance",
                  "customization/shortcuts",
                  "customization/layout",
                  "customization/site-settings"
                ]
              },
              {
                "group": "Sync & Backup",
                "icon": "cloud-arrow-up",
                "pages": [
                  "data/backup-sync",
                  "data/webdav",
                  {
                    "group": "From Other Platforms",
                    "pages": [
                      "data/migration"
                    ]
                  }
                ]
              },
              {
                "group": "Privacy & Permissions",
                "icon": "shield",
                "pages": [
                  "data/privacy",
                  "data/permissions"
                ]
              },
              {
                "group": "Help",
                "icon": "circle-question",
                "pages": [
                  "faq",
                  "troubleshooting"
                ]
              },
              {
                "group": "Changelog",
                "icon": "list",
                "pages": [
                  "changelog"
                ]
              }
            ]
          }
        ]
      },
      {
        "language": "cn",
        "tabs": [
          {
            "tab": "文档",
            "icon": "book-open",
            "groups": [
              {
                "group": "快速开始",
                "icon": "rocket",
                "pages": [
                  "zh/index",
                  "zh/introduction",
                  "zh/installation",
                  "zh/panel-overview"
                ]
              },
              {
